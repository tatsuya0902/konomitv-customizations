+<template>
+    <v-dialog max-width="700" transition="slide-y-transition" :model-value="show" @update:model-value="$emit('update:show', $event)">
+        <v-card class="highlights">
+            <v-card-title class="px-5 pt-6 pb-3 d-flex align-center font-weight-bold" style="height: 60px;">
+                <Icon icon="fluent:fire-16-filled" height="24px" />
+                <span class="ml-3">今日のハイライト</span>
+                <v-spacer></v-spacer>
+                <div v-ripple class="d-flex align-center rounded-circle cursor-pointer px-2 py-2" @click="$emit('update:show', false)">
+                    <Icon icon="fluent:dismiss-12-filled" width="23px" height="23px" />
+                </div>
+            </v-card-title>
+            <div class="px-5 pb-6">
+                <div class="highlights__summary">
+                    <span v-if="is_loading">今日の録画から盛り上がり区間を探しています…</span>
+                    <span v-else-if="items.length === 0">今日の録画に、コメントの盛り上がり区間は見つかりませんでした</span>
+                    <span v-else>{{items.length}} 区間・合計 {{formatPlaybackTime(total_seconds)}} (実況コメントの盛り上がりから自動抽出)</span>
+                </div>
+                <div class="highlights__list">
+                    <div v-for="(item, index) in items" :key="index" class="highlights__item">
+                        <span class="highlights__time">{{formatPlaybackTime(item.start)}}</span>
+                        <span class="highlights__title">{{item.title}}</span>
+                        <span class="highlights__count">{{item.comment_count}} 件</span>
+                    </div>
+                </div>
+                <div class="highlights__footer">
+                    <v-btn color="primary" variant="flat" :disabled="is_loading || items.length === 0" @click="startPlayback">
+                        ハイライトを再生
+                    </v-btn>
+                </div>
+            </div>
+        </v-card>
+    </v-dialog>
+</template>
+<script lang="ts">
+
+import { defineComponent } from 'vue';
+
+import { extractHighlightSegments, fetchCommentDensity, formatPlaybackTime, MIN_COMMENTS_FOR_HIGHLIGHTS } from '@/services/CommentHighlights';
+import { IHighlightReelItem, startHighlightReel } from '@/services/HighlightReel';
+import Videos, { IRecordedProgram } from '@/services/Videos';
+
+// ローカル改造: 今日の録画から実況コメントの盛り上がり区間を抽出し、横断再生するダイアログ
+interface IDisplayItem extends IHighlightReelItem {
+    comment_count: number;
+}
+
+export default defineComponent({
+    name: 'HighlightsDialog',
+    props: {
+        show: {
+            type: Boolean,
+            default: false,
+        },
+    },
+    emits: ['update:show'],
+    data() {
+        return {
+            // ユーティリティをテンプレートで使えるように
+            formatPlaybackTime: Object.freeze(formatPlaybackTime),
+
+            // 抽出したハイライト区間と読み込み状態
+            items: [] as IDisplayItem[],
+            is_loading: false,
+        };
+    },
+    computed: {
+        total_seconds(): number {
+            return this.items.reduce((sum, item) => sum + (item.end - item.start), 0);
+        },
+    },
+    watch: {
+        // ダイアログが開かれたらハイライトを抽出する
+        async show(is_shown: boolean): Promise<void> {
+            if (is_shown === true) {
+                await this.computeHighlights();
+            }
+        },
+    },
+    methods: {
+        // 今日の録画 (放送開始が今日のもの) から盛り上がり区間を抽出する
+        async computeHighlights(): Promise<void> {
+            this.is_loading = true;
+            this.items = [];
+            try {
+                const now = new Date();
+                const today_start = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime();
+                // 今日の録画を全ページから集める (新しい順に取得し、今日より古い番組が出たら打ち切る)
+                const todays_programs: IRecordedProgram[] = [];
+                let page = 1;
+                let total = Number.POSITIVE_INFINITY;
+                while (todays_programs.length < total && page <= 10) {
+                    const result = await Videos.fetchVideos('desc', page);
+                    if (result === null) {
+                        break;
+                    }
+                    total = result.total;
+                    let reached_older = false;
+                    for (const program of result.recorded_programs) {
+                        if (new Date(program.start_time).getTime() < today_start) {
+                            reached_older = true;
+                            break;
+                        }
+                        if (program.recorded_video.status === 'Recorded') {
+                            todays_programs.push(program);
+                        }
+                    }
+                    if (reached_older) {
+                        break;
+                    }
+                    page += 1;
+                }
+                // 古い順に、各録画から盛り上がりの強い区間を最大3つまで拾う (コメント取得の負荷を抑えるため対象は12件まで)
+                const items: IDisplayItem[] = [];
+                for (const program of todays_programs.slice().reverse().slice(0, 12)) {
+                    const density = await fetchCommentDensity(program.id, program.recorded_video.duration);
+                    if (density === null || density.total < MIN_COMMENTS_FOR_HIGHLIGHTS) {
+                        continue;
+                    }
+                    const segments = extractHighlightSegments(density);
+                    const top_segments = [...segments]
+                        .sort((a, b) => b.peak_density - a.peak_density)
+                        .slice(0, 3)
+                        .sort((a, b) => a.start - b.start);
+                    for (const segment of top_segments) {
+                        items.push({
+                            video_id: program.id,
+                            title: program.title,
+                            start: Math.max(0, segment.start - 3),  // 区間の少し手前から再生する
+                            end: segment.end,
+                            comment_count: segment.comment_count,
+                        });
+                    }
+                }
+                this.items = items;
+            } finally {
+                this.is_loading = false;
+            }
+        },
+        // ハイライト再生を開始する (キューを保存し、最初の録画の視聴画面へ移動する)
+        startPlayback(): void {
+            if (this.items.length === 0) {
+                return;
+            }
+            const reel_items: IHighlightReelItem[] = this.items.map((item) => ({
+                video_id: item.video_id,
+                title: item.title,
+                start: item.start,
+                end: item.end,
+            }));
+            startHighlightReel(reel_items);
+            this.$emit('update:show', false);
+            void this.$router.push({ path: `/videos/watch/${reel_items[0].video_id}` });
+        },
+    },
+});
+
+</script>
+<style lang="scss" scoped>
+
+.highlights {
+    &__summary {
+        font-size: 12.5px;
+        opacity: 0.8;
+    }
+    &__list {
+        margin-top: 10px;
+        max-height: 46vh;
+        overflow-y: auto;
+    }
+    &__item {
+        display: flex;
+        align-items: baseline;
+        gap: 10px;
+        padding: 7px 10px;
+    }
+    &__time {
+        flex-shrink: 0;
+        font-size: 12.5px;
+        font-weight: bold;
+        color: #e64f97;
+    }
+    &__title {
+        font-size: 13.5px;
+        white-space: nowrap;
+        overflow: hidden;
+        text-overflow: ellipsis;
+    }
+    &__count {
+        flex-shrink: 0;
+        font-size: 12px;
+        opacity: 0.75;
+    }
+    &__footer {
+        display: flex;
+        justify-content: flex-end;
+        margin-top: 16px;
+    }
+}
+
+</style>
