+/**
+ * ハイライト横断再生の再生キューを sessionStorage で引き継ぐためのモジュール (ローカル改造)
+ * HighlightsDialog がキューを作成し、視聴画面の HighlightReelManager が順に再生する。
+ * sessionStorage を使うため、タブを閉じるとキューは消える。
+ */
+
+/** ハイライトの1区間 */
+export interface IHighlightReelItem {
+    video_id: number;  // 録画の ID
+    title: string;  // 番組タイトル (表示用)
+    start: number;  // 再生開始位置 (秒)
+    end: number;  // 再生終了位置 (秒)
+}
+
+/** ハイライト再生キュー */
+export interface IHighlightReel {
+    items: IHighlightReelItem[];
+    index: number;  // 現在再生中の区間のインデックス
+}
+
+const STORAGE_KEY = 'konomi_highlight_reel';
+
+
+/**
+ * ハイライト再生を開始する (キューを保存する)
+ * @param items 再生する区間のリスト
+ */
+export function startHighlightReel(items: IHighlightReelItem[]): void {
+    const reel: IHighlightReel = { items, index: 0 };
+    sessionStorage.setItem(STORAGE_KEY, JSON.stringify(reel));
+}
+
+
+/**
+ * 保存されているハイライト再生キューを取得する。なければ null
+ */
+export function getHighlightReel(): IHighlightReel | null {
+    try {
+        const raw = sessionStorage.getItem(STORAGE_KEY);
+        if (raw === null) {
+            return null;
+        }
+        const reel = JSON.parse(raw) as IHighlightReel;
+        if (!Array.isArray(reel.items) || typeof reel.index !== 'number' || reel.items.length === 0) {
+            return null;
+        }
+        return reel;
+    } catch {
+        return null;
+    }
+}
+
+
+/**
+ * ハイライト再生キューを保存し直す (インデックスの進行時)
+ * @param reel ハイライト再生キュー
+ */
+export function saveHighlightReel(reel: IHighlightReel): void {
+    sessionStorage.setItem(STORAGE_KEY, JSON.stringify(reel));
+}
+
+
+/**
+ * ハイライト再生キューを破棄する
+ */
+export function clearHighlightReel(): void {
+    sessionStorage.removeItem(STORAGE_KEY);
+}
