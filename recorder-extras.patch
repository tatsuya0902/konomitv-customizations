+import usePlayerStore from '@/stores/PlayerStore';
+
+// ローカル改造: 録画の実況コメント (過去ログ) を検索し、ヒットした瞬間へシークするダイアログ
+export default defineComponent({
+    name: 'CommentSearchDialog',
+    props: {
+        program: {
+            type: Object as PropType<IRecordedProgram>,
+            required: true,
+        },
+        show: {
+            type: Boolean,
+            default: false,
+        },
+    },
+    emits: ['update:show'],
+    data() {
+        return {
+            // ユーティリティをテンプレートで使えるように
+            formatPlaybackTime: Object.freeze(formatPlaybackTime),
+
+            // 検索キーワードと、読み込んだコメント
+            query: '',
+            comments: [] as IJikkyoComment[],
+            is_loading: false,
+            loaded_for: null as number | null,
+        };
+    },
+    computed: {
+        ...mapStores(usePlayerStore),
+        filtered_comments(): IJikkyoComment[] {
+            const keyword = this.query.trim().toLowerCase();
+            if (keyword === '') {
+                return [];
+            }
+            return this.comments.filter((comment) => comment.text.toLowerCase().includes(keyword)).slice(0, 100);
+        },
+    },
+    watch: {
+        // ダイアログが開かれたらコメントを読み込む (同じ録画では再取得しない)
+        async show(is_shown: boolean): Promise<void> {
+            if (is_shown !== true || this.loaded_for === this.program.id) {
+                return;
+            }
+            this.loaded_for = this.program.id;
+            this.is_loading = true;
+            const result = await Videos.fetchVideoJikkyoComments(this.program.id);
+            this.comments = result.is_success === true ? result.comments : [];
+            this.is_loading = false;
+        },
+    },
+    methods: {
+        seekTo(time: number): void {
+            this.playerStore.event_emitter.emit('SeekRequest', { playback_position: time });
+            this.$emit('update:show', false);
+        },
+    },
+});
+
+</script>
+<style lang="scss" scoped>
