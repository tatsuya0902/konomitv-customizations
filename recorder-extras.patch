@@ -0,0 +1,184 @@
+import DPlayer from 'dplayer';
+
+import router from '@/router';
+import PlayerManager from '@/services/player/PlayerManager';
+import { sleep_timer_state } from '@/services/player/SleepTimerState';
+import Videos from '@/services/Videos';
+import usePlayerStore from '@/stores/PlayerStore';
+
+/**
+ * 録画の再生が終わったら、次の話をカウントダウン付きで自動再生する PlayerManager (ローカル改造)
+ *
+ * 次の話 (next_episode_id) がある録画でのみ有効になる。再生終了時にプレイヤー右下へ
+ * 「あと N 秒で次の話」というカードを表示し、キャンセルされなければ次の話の視聴画面へ移動する。
+ * おやすみタイマーの「番組の終わりで停止」が有効な場合は、自動再生せずにそのまま停止する。
+ * ユーザーが再生を再開した場合 (その場に留まる意思表示) もカウントダウンを中止する。
+ */
+class AutoPlayNextManager implements PlayerManager {
+
+    // ユーザー操作により DPlayer 側で画質が切り替わった際、この PlayerManager の再起動が必要かどうかを示す値
+    public readonly restart_required_when_quality_switched = false;
+
+    // 自動再生までのカウントダウン (秒)
+    private static readonly COUNTDOWN_SECONDS = 10;
+
+    // DPlayer のインスタンス
+    private readonly player: DPlayer;
+
+    // 再生モード (Live: ライブ視聴, Video: ビデオ視聴)
+    private readonly playback_mode: 'Live' | 'Video';
+
+    // 次の話の ID と、イベントリスナー・タイマー・表示要素
+    private next_episode_id: number | null = null;
+    private on_ended: (() => void) | null = null;
+    private on_play: (() => void) | null = null;
+    private overlay_element: HTMLDivElement | null = null;
+    private countdown_timer: ReturnType<typeof setInterval> | null = null;
+    private countdown_remaining = 0;
+
+    constructor(player: DPlayer, playback_mode: 'Live' | 'Video') {
+        this.player = player;
+        this.playback_mode = playback_mode;
+    }
+
+
+    /**
+     * AutoPlayNextManager を初期化する
+     * 次の話がある録画でのみ、再生終了を待ち受ける
+     */
+    public async init(): Promise<void> {
+        if (this.playback_mode !== 'Video') {
+            return;
+        }
+        const next_episode_id = usePlayerStore().recorded_program?.next_episode_id ?? null;
+        if (next_episode_id === null) {
+            return;
+        }
+        this.next_episode_id = next_episode_id;
+        this.on_ended = () => {
+            void this.showCountdown();
+        };
+        this.player.video.addEventListener('ended', this.on_ended);
+    }
+
+
+    /**
+     * AutoPlayNextManager を破棄する
+     */
+    public async destroy(): Promise<void> {
+        if (this.on_ended !== null) {
+            this.player.video.removeEventListener('ended', this.on_ended);
+            this.on_ended = null;
+        }
+        this.clearCountdown();
+    }
+
+
+    /**
+     * 再生終了時にカウントダウンカードを表示し、自動再生のタイマーを開始する
+     */
+    private async showCountdown(): Promise<void> {
+        if (this.next_episode_id === null) {
+            return;
+        }
+        // おやすみタイマー (番組の終わりで停止) が有効な場合は自動再生しない
+        if (sleep_timer_state.stop_at_end) {
+            this.player.notice('おやすみタイマーのため、ここで停止します');
+            return;
+        }
+        const next_program = await Videos.fetchVideo(this.next_episode_id);
+        const next_title = next_program?.title ?? '次の話';
+
+        this.clearCountdown();
+        const container = this.player.container;
+        const overlay = document.createElement('div');
+        overlay.style.cssText = 'position: absolute; right: 16px; bottom: 76px; z-index: 60; max-width: 78%;' +
+            'background: rgba(0,0,0,0.85); color: #fff; border-radius: 8px; padding: 12px 14px;' +
+            'font-size: 13px; line-height: 1.5; box-shadow: 0 4px 16px rgba(0,0,0,0.4);';
+        overlay.addEventListener('click', (event) => event.stopPropagation());
+
+        const label = document.createElement('div');
+        label.textContent = '次の話を再生します';
+        label.style.cssText = 'font-size: 11px; opacity: 0.75;';
+        overlay.appendChild(label);
+
+        const title = document.createElement('div');
+        title.textContent = next_title;
+        title.style.cssText = 'font-weight: bold; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 320px;';
+        overlay.appendChild(title);
+
+        const row = document.createElement('div');
+        row.style.cssText = 'display: flex; align-items: center; gap: 10px; margin-top: 8px;';
+        const countdown = document.createElement('span');
+        countdown.style.cssText = 'font-size: 12px; opacity: 0.9;';
+        row.appendChild(countdown);
+
+        const play_button = document.createElement('button');
+        play_button.type = 'button';
+        play_button.textContent = '今すぐ再生';
+        play_button.style.cssText = 'font-size: 12px; padding: 5px 10px; border-radius: 999px; border: none;' +
+            'background: #e64f97; color: #fff; cursor: pointer;';
+        play_button.addEventListener('click', () => this.goNext());
+        row.appendChild(play_button);
+
+        const cancel_button = document.createElement('button');
+        cancel_button.type = 'button';
+        cancel_button.textContent = 'キャンセル';
+        cancel_button.style.cssText = 'font-size: 12px; padding: 5px 10px; border-radius: 999px;' +
+            'border: 1px solid rgba(255,255,255,0.6); background: transparent; color: #fff; cursor: pointer;';
+        cancel_button.addEventListener('click', () => this.clearCountdown());
+        row.appendChild(cancel_button);
+
+        overlay.appendChild(row);
+        container.appendChild(overlay);
+        this.overlay_element = overlay;
+
+        // ユーザーが再生を再開したら、その場に留まる意思表示としてカウントダウンを中止する
+        this.on_play = () => this.clearCountdown();
+        this.player.video.addEventListener('play', this.on_play);
+
+        this.countdown_remaining = AutoPlayNextManager.COUNTDOWN_SECONDS;
+        countdown.textContent = `あと ${this.countdown_remaining} 秒`;
+        this.countdown_timer = setInterval(() => {
+            this.countdown_remaining -= 1;
+            if (this.countdown_remaining <= 0) {
+                this.goNext();
+                return;
+            }
+            countdown.textContent = `あと ${this.countdown_remaining} 秒`;
+        }, 1000);
+    }
+
+
+    /**
+     * カウントダウンを中止し、カードを取り除く
+     */
+    private clearCountdown(): void {
+        if (this.countdown_timer !== null) {
+            clearInterval(this.countdown_timer);
+            this.countdown_timer = null;
+        }
+        if (this.on_play !== null) {
+            this.player.video.removeEventListener('play', this.on_play);
+            this.on_play = null;
+        }
+        if (this.overlay_element !== null) {
+            this.overlay_element.remove();
+            this.overlay_element = null;
+        }
+    }
+
+
+    /**
+     * 次の話の視聴画面へ移動する
+     */
+    private goNext(): void {
+        const next_episode_id = this.next_episode_id;
+        this.clearCountdown();
+        if (next_episode_id !== null) {
+            void router.push({ path: `/videos/watch/${next_episode_id}` });
+        }
+    }
+}
+
+export default AutoPlayNextManager;
diff --git a/client/src/services/player/managers/HighlightReelManager.ts b/client/src/services/player/managers/HighlightReelManager.ts
