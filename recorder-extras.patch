+        max-height: 46vh;
+        overflow-y: auto;
+    }
+    &__item {
+        display: flex;
+        align-items: baseline;
+        gap: 10px;
+        padding: 7px 10px;
+        border-radius: 6px;
+        cursor: pointer;
+        &:hover {
+            background: rgba(230, 79, 151, 0.10);
+        }
+    }
+    &__time {
+        flex-shrink: 0;
+        font-size: 12.5px;
+        font-weight: bold;
+        color: #e64f97;
+    }
+    &__text {
+        font-size: 13.5px;
+        word-break: break-all;
+    }
+}
