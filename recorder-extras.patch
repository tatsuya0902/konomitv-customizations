@@ -0,0 +1,210 @@
+import DPlayer from 'dplayer';
+
+import router from '@/router';
+import { clearHighlightReel, getHighlightReel, IHighlightReel, saveHighlightReel } from '@/services/HighlightReel';
+import PlayerManager from '@/services/player/PlayerManager';
+import usePlayerStore from '@/stores/PlayerStore';
+
+/**
+ * ハイライト横断再生を制御する PlayerManager (ローカル改造)
+ *
+ * sessionStorage の再生キュー (HighlightReel) があり、開いた録画がキューの現在区間と
+ * 一致する場合に有効になる。区間の開始位置へシークし、終了位置に達したら次の区間へ進む
+ * (別の録画の場合はその視聴画面へ移動する)。キューと一致しない録画を開いた場合は、
+ * ユーザーが手動で移動したとみなしてキューを破棄する。
+ */
+class HighlightReelManager implements PlayerManager {
+
+    // ユーザー操作により DPlayer 側で画質が切り替わった際、この PlayerManager の再起動が必要かどうかを示す値
+    public readonly restart_required_when_quality_switched = false;
+
+    // DPlayer のインスタンス
+    private readonly player: DPlayer;
+
+    // 再生モード (Live: ライブ視聴, Video: ビデオ視聴)
+    private readonly playback_mode: 'Live' | 'Video';
+
+    // 再生キューと、開始シーク済みかどうか、監視タイマーとバッジ要素
+    private reel: IHighlightReel | null = null;
+    private has_seeked_to_start = false;
+    private monitor_timer: ReturnType<typeof setInterval> | null = null;
+    private badge_element: HTMLDivElement | null = null;
+
+    constructor(player: DPlayer, playback_mode: 'Live' | 'Video') {
+        this.player = player;
+        this.playback_mode = playback_mode;
+    }
+
+
+    /**
+     * HighlightReelManager を初期化する
+     * 再生キューがあり、開いた録画が現在の区間と一致する場合のみ有効になる
+     */
+    public async init(): Promise<void> {
+        if (this.playback_mode !== 'Video') {
+            return;
+        }
+        const reel = getHighlightReel();
+        if (reel === null) {
+            return;
+        }
+        const current_item = reel.items[reel.index];
+        const current_video_id = usePlayerStore().recorded_program?.id;
+        if (current_item === undefined || current_item.video_id !== current_video_id) {
+            // 別の録画を開いた = ハイライト再生を中断したとみなす
+            clearHighlightReel();
+            return;
+        }
+        this.reel = reel;
+        this.showBadge();
+        this.monitor_timer = setInterval(() => this.onTick(), 500);
+    }
+
+
+    /**
+     * HighlightReelManager を破棄する
+     * (キュー自体は次の視聴画面へ引き継ぐため、ここでは破棄しない)
+     */
+    public async destroy(): Promise<void> {
+        if (this.monitor_timer !== null) {
+            clearInterval(this.monitor_timer);
+            this.monitor_timer = null;
+        }
+        if (this.badge_element !== null) {
+            this.badge_element.remove();
+            this.badge_element = null;
+        }
+        this.reel = null;
+    }
+
+
+    /**
+     * 「ハイライト再生中 n/m」バッジをプレイヤー左上に表示する (× で中断)
+     */
+    private showBadge(): void {
+        if (this.reel === null) {
+            return;
+        }
+        const badge = document.createElement('div');
+        badge.style.cssText = 'position: absolute; left: 12px; top: 12px; z-index: 60; display: flex; align-items: center; gap: 8px;' +
+            'background: rgba(0,0,0,0.7); color: #fff; border-radius: 999px; padding: 5px 8px 5px 12px; font-size: 12px;';
+        const label = document.createElement('span');
+        label.textContent = `ハイライト再生中 ${this.reel.index + 1}/${this.reel.items.length}`;
+        badge.appendChild(label);
+        const close = document.createElement('button');
+        close.type = 'button';
+        close.textContent = '✕';
+        close.style.cssText = 'border: none; background: rgba(255,255,255,0.2); color: #fff; border-radius: 999px;' +
+            'width: 20px; height: 20px; line-height: 1; cursor: pointer; font-size: 11px;';
+        close.addEventListener('click', (event) => {
+            event.stopPropagation();
+            this.abort();
+        });
+        badge.appendChild(close);
+        this.player.container.appendChild(badge);
+        this.badge_element = badge;
+    }
+
+
+    /**
+     * 500ms ごとの監視。開始シークと、区間終了時の次の区間への進行を行う
+     */
+    private onTick(): void {
+        if (this.reel === null) {
+            return;
+        }
+        const item = this.reel.items[this.reel.index];
+        if (item === undefined) {
+            this.finish();
+            return;
+        }
+        const video = this.player.video;
+        // 再生開始直後は、区間の開始位置へシークする (プレイヤーの初期シークが落ち着いてから)
+        if (this.has_seeked_to_start === false) {
+            if (video.readyState >= 1 && Number.isFinite(video.duration) && video.duration > 0) {
+                this.has_seeked_to_start = true;
+                this.player.seek(Math.max(0, item.start));
+                if (video.paused) {
+                    video.play().catch(() => {
+                        // 自動再生が拒否された場合は何もしない
+                    });
+                }
+            }
+            return;
+        }
+        if (video.currentTime >= item.end - 0.25) {
+            this.advance();
+        }
+    }
+
+
+    /**
+     * 次の区間へ進む。最後の区間なら終了する
+     */
+    private advance(): void {
+        if (this.reel === null) {
+            return;
+        }
+        this.reel.index += 1;
+        if (this.reel.index >= this.reel.items.length) {
+            this.finish();
+            return;
+        }
+        saveHighlightReel(this.reel);
+        const next = this.reel.items[this.reel.index];
+        const current_video_id = usePlayerStore().recorded_program?.id;
+        if (next.video_id === current_video_id) {
+            // 同じ録画内の次の区間へシークする
+            this.has_seeked_to_start = true;
+            this.player.seek(Math.max(0, next.start));
+            if (this.badge_element !== null) {
+                const label = this.badge_element.querySelector('span');
+                if (label !== null) {
+                    label.textContent = `ハイライト再生中 ${this.reel.index + 1}/${this.reel.items.length}`;
+                }
+            }
+        } else {
+            // 別の録画の視聴画面へ移動する (移動先でこの Manager が再初期化され、続きを再生する)
+            void router.push({ path: `/videos/watch/${next.video_id}` });
+        }
+    }
+
+
+    /**
+     * ハイライト再生を終了する
+     */
+    private finish(): void {
+        clearHighlightReel();
+        this.player.pause();
+        this.player.notice('ハイライト再生が終了しました');
+        if (this.monitor_timer !== null) {
+            clearInterval(this.monitor_timer);
+            this.monitor_timer = null;
+        }
+        if (this.badge_element !== null) {
+            this.badge_element.remove();
+            this.badge_element = null;
+        }
+        this.reel = null;
+    }
+
+
+    /**
+     * ユーザー操作でハイライト再生を中断する
+     */
+    private abort(): void {
+        clearHighlightReel();
+        this.player.notice('ハイライト再生を終了しました');
+        if (this.monitor_timer !== null) {
+            clearInterval(this.monitor_timer);
+            this.monitor_timer = null;
+        }
+        if (this.badge_element !== null) {
+            this.badge_element.remove();
+            this.badge_element = null;
+        }
+        this.reel = null;
+    }
+}
+
+export default HighlightReelManager;
diff --git a/client/src/services/player/managers/SleepTimerManager.ts b/client/src/services/player/managers/SleepTimerManager.ts
new file mode 100644
index 0000000..90be7b5
--- /dev/null
+++ b/client/src/services/player/managers/SleepTimerManager.ts
@@ -0,0 +1,145 @@
+import DPlayer from 'dplayer';
+
+import PlayerManager from '@/services/player/PlayerManager';
+import { sleep_timer_state } from '@/services/player/SleepTimerState';
+
+/**
+ * おやすみタイマー (ローカル改造)
+ *
+ * プレイヤーのコントロールにタイマーボタンを追加し、タップするたびに
+ * オフ → 15分 → 30分 → 60分 → (録画再生時のみ) 番組の終わりで停止 → オフ と切り替える。
+ * 時間が来たら再生を一時停止する。「番組の終わりで停止」は SleepTimerState 経由で
+ * AutoPlayNextManager に伝わり、次の話の自動再生を抑止する形で実現する。
+ */
+class SleepTimerManager implements PlayerManager {
+
+    // ユーザー操作により DPlayer 側で画質が切り替わった際、この PlayerManager の再起動が必要かどうかを示す値
+    public readonly restart_required_when_quality_switched = false;
+
+    // DPlayer のインスタンス
+    private readonly player: DPlayer;
+
+    // 再生モード (Live: ライブ視聴, Video: ビデオ視聴)
+    private readonly playback_mode: 'Live' | 'Video';
+
+    // タイマーボタンと、選択中のモード、残り時間 (秒, null は未設定)
+    private button: HTMLButtonElement | null = null;
+    private mode_index = 0;
+    private remaining_seconds: number | null = null;
+    private stop_at_end = false;
+    private ticker: ReturnType<typeof setInterval> | null = null;
+
+    constructor(player: DPlayer, playback_mode: 'Live' | 'Video') {
+        this.player = player;
+        this.playback_mode = playback_mode;
+    }
+
+
+    /**
+     * SleepTimerManager を初期化する
+     * 再生ボタンの並びにタイマーボタンを追加する
+     */
+    public async init(): Promise<void> {
+        // 万が一すでにボタンが存在していた場合は削除する
+        for (const element of this.player.container.querySelectorAll('.konomi-sleep-timer-button')) {
+            element.remove();
+        }
+        const play_icon = this.player.container.querySelector('.dplayer-play-icon');
+        if (play_icon === null || play_icon.parentElement === null) {
+            return;
+        }
+        const button = document.createElement('button');
+        button.type = 'button';
+        button.className = 'konomi-sleep-timer-button';
+        button.style.cssText = 'margin-left: 8px; padding: 3px 9px; border-radius: 999px;' +
+            'border: 1px solid rgba(255,255,255,0.4); background: rgba(0,0,0,0.3); color: #fff;' +
+            'font-size: 11px; line-height: 1.4; cursor: pointer; white-space: nowrap;';
+        button.addEventListener('click', (event) => {
+            event.stopPropagation();
+            this.cycleMode();
+        });
+        play_icon.parentElement.appendChild(button);
+        this.button = button;
+        this.updateLabel();
+
+        this.ticker = setInterval(() => this.onTick(), 1000);
+    }
+
+
+    /**
+     * SleepTimerManager を破棄する
+     */
+    public async destroy(): Promise<void> {
+        if (this.ticker !== null) {
+            clearInterval(this.ticker);
+            this.ticker = null;
+        }
+        if (this.button !== null) {
+            this.button.remove();
+            this.button = null;
+        }
+        this.remaining_seconds = null;
+        this.stop_at_end = false;
+        sleep_timer_state.stop_at_end = false;
+    }
+
+
+    /**
+     * タイマーのモードを順に切り替える
+     * オフ → 15分 → 30分 → 60分 → (録画のみ) 番組の終わりで停止 → オフ
+     */
+    private cycleMode(): void {
+        const modes = this.playback_mode === 'Video' ? ['off', '15', '30', '60', 'end'] : ['off', '15', '30', '60'];
+        this.mode_index = (this.mode_index + 1) % modes.length;
+        const mode = modes[this.mode_index];
+        this.stop_at_end = mode === 'end';
+        this.remaining_seconds = (mode === '15' || mode === '30' || mode === '60') ? parseInt(mode) * 60 : null;
+        sleep_timer_state.stop_at_end = this.stop_at_end;
+        this.updateLabel();
+        if (this.stop_at_end) {
+            this.player.notice('おやすみタイマー: この番組の終わりで停止します');
+        } else if (this.remaining_seconds !== null) {
+            this.player.notice(`おやすみタイマー: ${mode} 分後に停止します`);
+        } else {
+            this.player.notice('おやすみタイマーをオフにしました');
+        }
+    }
+
+
+    /**
+     * 1秒ごとの処理。残り時間を減らし、0 になったら再生を停止する
+     */
+    private onTick(): void {
+        if (this.remaining_seconds === null) {
+            return;
+        }
+        this.remaining_seconds -= 1;
+        if (this.remaining_seconds <= 0) {
+            this.remaining_seconds = null;
+            this.player.pause();
+            this.player.notice('おやすみタイマーで停止しました');
+        }
+        this.updateLabel();
+    }
+
+
+    /**
+     * ボタンのラベルを現在の状態に合わせて更新する
+     */
+    private updateLabel(): void {
+        if (this.button === null) {
+            return;
+        }
+        if (this.stop_at_end) {
+            this.button.textContent = '⏰ 終了時';
+        } else if (this.remaining_seconds !== null) {
+            const minutes = Math.floor(this.remaining_seconds / 60);
+            const seconds = this.remaining_seconds % 60;
+            this.button.textContent = `⏰ ${minutes}:${seconds.toString().padStart(2, '0')}`;
+        } else {
+            this.button.textContent = '⏰ オフ';
+        }
+    }
+}
+
+export default SleepTimerManager;
