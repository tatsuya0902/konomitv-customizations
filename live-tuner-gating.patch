@@ -0,0 +1,154 @@
+import time
+from typing import Any
+
+import httpx
+
+from app import logging
+from app.config import Config
+from app.constants import HTTPX_CLIENT
+from app.utils import GetMirakurunAPIEndpointURL
+
+
+class TunerStatus:
+    """
+    Mirakurun のチューナー使用状況をもとに、各チャンネルがライブ視聴可能かどうかを判定するクラス
+
+    Mirakurun では、チューナーが受信中のチャンネル (放送波の物理チャンネル) と同じチャンネルの
+    ストリームは、チューナーに空きがなくても追加で視聴できる (1 台のチューナーを共有できる)。
+    逆に、空きチューナーがなく受信中でもないチャンネルは、ストリームを開始しても
+    Mirakurun 側でエラーになり視聴できない。
+    このクラスは Mirakurun の /api/tuners と /api/services から現在の使用状況を取得し、
+    チャンネルごとの視聴可否を判定するための情報を提供する。
+    """
+
+    # チューナー使用状況のキャッシュ
+    ## チャンネル一覧 API は呼ばれる頻度が高いため、短時間に何度も Mirakurun API を叩かないよう保持する
+    ## fetch() で取得・更新され、isViewable() から参照される
+    _cache: dict[str, Any] | None = None
+
+    # チューナー使用状況キャッシュの最終取得時刻 (UNIX タイムスタンプ、秒単位)
+    ## fetch() でキャッシュの鮮度判定に使われる
+    _cache_at: float = 0
+
+    # キャッシュの有効期間 (秒)
+    ## 録画開始・終了の反映が数秒遅れても実用上問題ないため、この間は再取得しない
+    CACHE_TTL_SECONDS: float = 5.0
+
+
+    @classmethod
+    async def fetch(cls) -> dict[str, Any] | None:
+        """
+        Mirakurun からチューナー使用状況を取得する (短時間キャッシュ付き)
+
+        Returns:
+            dict[str, Any] | None: チューナー使用状況を表す辞書。
+            Mirakurun バックエンドでない場合や取得に失敗した場合は None を返す (None の場合は全チャンネル視聴可として扱う)。
+            辞書の内容は以下の通り。
+            - free_tuners (int): 空きチューナーの台数
+            - tuned_channels (set[tuple[str, str]]): 受信中の (チャンネルタイプ, Mirakurun チャンネル) の集合
+            - service_channels (dict[tuple[int, int], tuple[str, str]]): (ネットワーク ID, サービス ID) から
+              (チャンネルタイプ, Mirakurun チャンネル) への対応表
+        """
+
+        # 実際に Mirakurun から受信する構成でない場合はチューナー状況を判定できないため、None を返す
+        ## バックエンドが EDCB でも always_receive_tv_from_mirakurun が有効なら Mirakurun から受信する
+        ## (LiveEncodingTask でのバックエンド判定と同じ条件)
+        backend = 'Mirakurun' if Config().general.always_receive_tv_from_mirakurun is True else Config().general.backend
+        if backend != 'Mirakurun':
+            return None
+
+        # キャッシュが新鮮な場合はそのまま返す
+        if cls._cache is not None and (time.time() - cls._cache_at) < cls.CACHE_TTL_SECONDS:
+            return cls._cache
+
+        # Mirakurun のサービス一覧とチューナー使用状況を取得する
+        try:
+            async with HTTPX_CLIENT() as client:
+                services_response = await client.get(GetMirakurunAPIEndpointURL('/api/services'), timeout=5)
+                tuners_response = await client.get(GetMirakurunAPIEndpointURL('/api/tuners'), timeout=5)
+            if services_response.status_code != 200 or tuners_response.status_code != 200:
+                logging.warning('[TunerStatus] Failed to fetch tuner status from Mirakurun. '
+                                f'(services: HTTP {services_response.status_code}, tuners: HTTP {tuners_response.status_code})')
+                return None
+            services = services_response.json()
+            tuners = tuners_response.json()
+        except (httpx.NetworkError, httpx.TimeoutException, ValueError) as ex:
+            # Mirakurun に接続できない場合は視聴可否を判定できないため、None を返す (全チャンネル視聴可として扱う)
+            logging.warning(f'[TunerStatus] Failed to fetch tuner status from Mirakurun. ({type(ex).__name__})')
+            return None
+
+        # (ネットワーク ID, サービス ID) から、そのサービスが属する Mirakurun チャンネルへの対応表を作成する
+        ## KonomiTV のチャンネル情報には Mirakurun のチャンネル文字列 (例: GR の物理チャンネルや BS のスロット) が
+        ## 含まれていないため、Mirakurun のサービス一覧から対応を引く必要がある
+        service_channels: dict[tuple[int, int], tuple[str, str]] = {}
+        for service in services:
+            channel = service.get('channel') or {}
+            if channel.get('type') is not None and channel.get('channel') is not None:
+                service_channels[(service['networkId'], service['serviceId'])] = (channel['type'], channel['channel'])
+
+        # 空きチューナーの台数と、受信中のチャンネルの集合を求める
+        free_tuners = 0
+        tuned_channels: set[tuple[str, str]] = set()
+        for tuner in tuners:
+            users = tuner.get('users') or []
+
+            # ユーザーがいないチューナーは空きチューナーとして数える
+            if len(users) == 0:
+                free_tuners += 1
+                continue
+
+            # 各ユーザーが受信中のチャンネルを集合に追加する
+            for user in users:
+                stream_setting = user.get('streamSetting') or {}
+                channel = stream_setting.get('channel') or {}
+
+                # ストリーム設定にチャンネルが直接含まれている場合はそれを使う
+                if channel.get('type') is not None and channel.get('channel') is not None:
+                    tuned_channels.add((channel['type'], channel['channel']))
+                    continue
+
+                # 含まれていない場合はサービス ID から対応を引く
+                service_channel = service_channels.get((stream_setting.get('networkId'), stream_setting.get('serviceId')))
+                if service_channel is not None:
+                    tuned_channels.add(service_channel)
+
+        # 取得結果をキャッシュして返す
+        cls._cache = {
+            'free_tuners': free_tuners,
+            'tuned_channels': tuned_channels,
+            'service_channels': service_channels,
+        }
+        cls._cache_at = time.time()
+        return cls._cache
+
+
+    @classmethod
+    def isViewable(cls, tuner_status: dict[str, Any] | None, network_id: int, service_id: int) -> bool:
+        """
+        指定されたチャンネルがライブ視聴可能かどうかを判定する
+
+        Args:
+            tuner_status (dict[str, Any] | None): fetch() で取得したチューナー使用状況 (None の場合は常に視聴可)
+            network_id (int): チャンネルのネットワーク ID
+            service_id (int): チャンネルのサービス ID
+
+        Returns:
+            bool: 空きチューナーがある、または既に受信中のチャンネルなら True、そうでなければ False
+        """
+
+        # チューナー使用状況が取得できていない場合は、視聴を妨げないよう視聴可として扱う
+        if tuner_status is None:
+            return True
+
+        # 空きチューナーがあればどのチャンネルでも視聴できる
+        if tuner_status['free_tuners'] > 0:
+            return True
+
+        # 空きがない場合でも、既に受信中のチャンネル (物理チャンネル単位) であればチューナーを共有して視聴できる
+        service_channel = tuner_status['service_channels'].get((network_id, service_id))
+
+        # Mirakurun チャンネルへの対応が取れないチャンネルは判定できないため、視聴可として扱う
+        if service_channel is None:
+            return True
+
+        return service_channel in tuner_status['tuned_channels']
