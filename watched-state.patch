+"""録画の視聴状態 (どこまで見たか) のサーバー側管理。
+
+ローカル改造 (2026-11-13): 視聴進捗を端末ごとのローカル履歴ではなくサーバーで
+一元管理し、ログアウト中やどの端末からでも同じ「未視聴 / 視聴済み」判定が
+できるようにするために新設した。市販レコーダーと同様、世帯で 1 つの状態として扱う。
+再生中のクライアントが到達した最大の再生位置を報告し (POST /api/videos/{id}/watched)、
+状態は DATA_DIR/watched-state.json に保存する。
+"""
+
+import json
+import logging
+import threading
+import time
+
+from app.constants import DATA_DIR
+
+
+STATE_PATH = DATA_DIR / 'watched-state.json'
+
+_lock = threading.Lock()
+
+
+def _loadState() -> dict[int, dict[str, float]]:
+    """視聴状態を読み込む。ファイルがない・壊れている場合は空として扱う。"""
+    try:
+        raw = json.loads(STATE_PATH.read_text(encoding='utf-8'))
+        return {int(video_id): entry for video_id, entry in raw.items()}
+    except FileNotFoundError:
+        return {}
+    except Exception:
+        logging.exception('[WatchedState] Failed to load watched state.')
+        return {}
+
+
+def _saveState(state: dict[int, dict[str, float]]) -> None:
+    """視聴状態を保存する (一時ファイルに書いてから置き換える)。"""
+    tmp_path = STATE_PATH.with_suffix('.json.tmp')
+    tmp_path.write_text(
+        json.dumps({str(video_id): entry for video_id, entry in state.items()}, ensure_ascii=False, indent=2),
+        encoding='utf-8',
+    )
+    tmp_path.replace(STATE_PATH)
+
+
+def report(video_id: int, position: float) -> None:
+    """再生位置の報告を記録する。保存済みの最大位置より進んだ場合のみ更新する。"""
+    if position < 0:
+        return
+    with _lock:
+        state = _loadState()
+        entry = state.get(video_id)
+        if entry is not None and position <= entry['max_position'] + 1.0:
+            return
+        state[video_id] = {'max_position': float(position), 'updated_at': time.time()}
+        _saveState(state)
+
+
+def maxPositions() -> dict[int, float]:
+    """全録画の最大到達再生位置 {video_id: 秒} を返す。"""
+    return {video_id: entry['max_position'] for video_id, entry in _loadState().items()}
+
+
+def forget(video_id: int) -> None:
+    """録画の視聴状態を削除する (録画自体の削除に合わせて呼ぶ想定)。"""
+    with _lock:
+        state = _loadState()
+        if video_id in state:
+            del state[video_id]
+            _saveState(state)
