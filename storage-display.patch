+import shutil
+import time
+from typing import Any
+
+from app import logging
+from app.models.RecordedVideo import RecordedVideo
+
+
+class StorageStatus:
+    """
+    録画ファイルが置かれているストレージの容量情報を提供するクラス (ローカル改造)
+
+    録画ファイルの保存先は設定ではなく、実際に登録されている録画ファイルのパスから特定する。
+    最新の録画ファイルがあるファイルシステムについて、全体容量・使用量・空き容量を返す。
+    あわせて、録画ファイル自体の合計サイズ (DB に記録された file_size の合計) も返すため、
+    ストレージを他の用途と共有している環境でも「録画が使っている容量」が分かる。
+    取得は比較的低頻度でよい情報のため、短時間キャッシュして DB とディスクへの問い合わせを抑える。
+    """
+
+    # 容量情報のキャッシュ
+    ## fetch() で取得・更新される
+    _cache: dict[str, Any] | None = None
+
+    # 容量情報キャッシュの最終取得時刻 (UNIX タイムスタンプ、秒単位)
+    ## fetch() でキャッシュの鮮度判定に使われる
+    _cache_at: float = 0
+
+    # キャッシュの有効期間 (秒)
+    ## 容量は秒単位で大きく変わらないため、この間は再取得しない
+    CACHE_TTL_SECONDS: float = 60.0
+
+
+    @classmethod
+    async def fetch(cls) -> dict[str, Any] | None:
+        """
+        録画ストレージの容量情報を取得する (短時間キャッシュ付き)
+
+        Returns:
+            dict[str, Any] | None: 容量情報を表す辞書。録画ファイルが 1 件も登録されていない場合や
+            取得に失敗した場合は None を返す。
+            辞書の内容は以下の通り。
+            - total_bytes (int): ストレージの全体容量 (バイト)
+            - used_bytes (int): ストレージの使用量 (バイト)
+            - free_bytes (int): ストレージの空き容量 (バイト)
+            - recordings_bytes (int): 録画ファイル自体の合計サイズ (バイト)
+        """
+
+        # キャッシュが有効期間内ならそのまま返す
+        now = time.monotonic()
+        if cls._cache is not None and (now - cls._cache_at) < cls.CACHE_TTL_SECONDS:
+            return cls._cache
+
+        try:
+            # 最新の録画ファイルのパスから、保存先のファイルシステムを特定する
+            latest_video = await RecordedVideo.all().order_by('-id').first()
+            if latest_video is None:
+                return None
+            usage = shutil.disk_usage(latest_video.file_path)
+
+            # 録画ファイル自体の合計サイズ (DB に記録されたファイルサイズの合計)
+            file_sizes = await RecordedVideo.all().values_list('file_size', flat=True)
+            recordings_bytes = sum(file_sizes)
+
+            cls._cache = {
+                'total_bytes': usage.total,
+                'used_bytes': usage.used,
+                'free_bytes': usage.free,
+                'recordings_bytes': recordings_bytes,
+            }
+            cls._cache_at = now
+            return cls._cache
+        except Exception as ex:
+            logging.error('[StorageStatus] Failed to get storage status:', exc_info=ex)
+            return None
