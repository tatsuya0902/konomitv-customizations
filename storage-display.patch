+<template>
+    <div v-if="storage_status" class="storage-status-text">
+        <Icon icon="fluent:database-20-regular" width="16px" height="16px" />
+        <span>録画 {{ formatBytes(storage_status.recordings_bytes) }} / {{ formatBytes(storage_status.total_bytes) }}（空き {{ formatBytes(storage_status.free_bytes) }}）</span>
+    </div>
+</template>
+<script lang="ts" setup>
+
+import { onMounted, onUnmounted, ref } from 'vue';
+
+import { IStorageStatus } from '@/services/Videos';
+import Videos from '@/services/Videos';
+
+// 録画ストレージの容量情報 (ローカル改造、取得できなかった場合は null のまま表示しない)
+const storage_status = ref<IStorageStatus | null>(null);
+
+// 自動更新用の interval ID を保持
+const refresh_interval = ref<number | null>(null);
+
+// バイト数を人が読みやすい単位 (GB / TB) に整形する
+const formatBytes = (bytes: number): string => {
+    if (bytes >= 1024 ** 4) {
+        return `${(bytes / 1024 ** 4).toFixed(1)} TB`;
+    }
+    if (bytes >= 1024 ** 3) {
+        return `${(bytes / 1024 ** 3).toFixed(1)} GB`;
+    }
+    if (bytes >= 1024 ** 2) {
+        return `${(bytes / 1024 ** 2).toFixed(1)} MB`;
+    }
+    return `${bytes} B`;
+};
+
+// 録画ストレージの容量情報を取得
+const fetchStorageStatus = async () => {
+    storage_status.value = await Videos.getStorageStatus();
+};
+
+// 開始時に取得し、録画の進行に合わせて定期的に更新する
+onMounted(() => {
+    fetchStorageStatus();
+    refresh_interval.value = window.setInterval(fetchStorageStatus, 30 * 1000);
+});
+
+// コンポーネントのクリーンアップ
+onUnmounted(() => {
+    if (refresh_interval.value !== null) {
+        clearInterval(refresh_interval.value);
+        refresh_interval.value = null;
+    }
+});
+
+</script>
+<style lang="scss" scoped>
+
+.storage-status-text {
+    display: inline-flex;
+    align-items: center;
+    gap: 6px;
+    font-size: 13.5px;
+    opacity: 0.75;
+    user-select: none;
+}
+
+</style>
