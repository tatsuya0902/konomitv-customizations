diff --git a/client/src/services/CommentHighlights.ts b/client/src/services/CommentHighlights.ts
index 293a918..150572b 100644
--- a/client/src/services/CommentHighlights.ts
+++ b/client/src/services/CommentHighlights.ts
@@ -24,6 +24,10 @@ const MAX_GAP_BINS = 2;
 const MIN_SEGMENT_BINS = 3;
 // 区間の合計がこの比率を超えたら盛り上がり区間として扱わない
 const MAX_COVERAGE_RATIO = 0.7;
+// 区間の前後に付ける余白 (秒)。実況コメントは映像より遅れて付くため開始側を長めに取り、
+// 相撲の取組のように瞬間的に決まる場面でも、始まりから決着の余韻まで含める
+const SEGMENT_PAD_START_SECONDS = 15;
+const SEGMENT_PAD_END_SECONDS = 10;
 
 /** 盛り上がり区間 */
 export interface IHighlightSegment {
@@ -141,7 +145,21 @@ export function extractHighlightSegments(density: ICommentDensity): IHighlightSe
     if (density.duration > 0 && covered / density.duration > MAX_COVERAGE_RATIO) {
         return [];
     }
-    return segments;
+    // 区間に前後の余白を付け、重なった区間はまとめる
+    const padded: IHighlightSegment[] = [];
+    for (const segment of segments) {
+        const start = Math.max(0, segment.start - SEGMENT_PAD_START_SECONDS);
+        const end = Math.min(density.duration, segment.end + SEGMENT_PAD_END_SECONDS);
+        const last = padded[padded.length - 1];
+        if (last && start <= last.end) {
+            last.end = Math.max(last.end, end);
+            last.peak_density = Math.max(last.peak_density, segment.peak_density);
+            last.comment_count += segment.comment_count;
+        } else {
+            padded.push({ start, end, peak_density: segment.peak_density, comment_count: segment.comment_count });
+        }
+    }
+    return padded;
 }
 
 
