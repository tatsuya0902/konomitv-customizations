+/**
+ * UI の表示倍率 (ui_scale) をページ全体に適用する
+ * - 適用先は documentElement (html 要素) 。Vuetify のオーバーレイ (メニューやダイアログ) は
+ *   document.body 直下に teleport されるため、v-app 要素だけに zoom を付けるとオーバーレイが
+ *   縮小されず、表示位置の計算もずれてしまう。ページ全体を一体でスケールさせることで、
+ *   ブラウザのページズームと同じ座標系で fixed 要素やオーバーレイも一緒にスケールする
+ * - あわせて倍率を CSS 変数 --ui-scale にも設定する。Safari では html への zoom 適用時に
+ *   dvh などのビューポート単位が zoom に追随せず画面の高さより短く算出されるため、
+ *   ビューポート単位で高さを決めている箇所ではこの変数で割って補正する
+ * - 100% のとき (または値が不正なとき) は zoom プロパティ自体を設定しないため、従来の表示と完全に同一になる
+ * - 全画面表示中は、プレイヤーの表示が倍率の影響を受けないよう一時的に適用を外す
+ *   (iPhone の動画全画面再生はネイティブプレイヤーに移るため元々影響を受けないが、PC の全画面表示向けの配慮)
+ */
+function applyUiScale(): void {
+    const ui_scale = settingsStore.settings.ui_scale;
+    const effective_scale = (typeof ui_scale === 'number' && Number.isFinite(ui_scale)) ?
+        Math.min(150, Math.max(50, ui_scale)) : 100;
+    if (effective_scale === 100 || document.fullscreenElement !== null) {
+        document.documentElement.style.removeProperty('zoom');
+        document.documentElement.style.removeProperty('--ui-scale');
+    } else {
+        document.documentElement.style.zoom = `${effective_scale / 100}`;
+        document.documentElement.style.setProperty('--ui-scale', `${effective_scale / 100}`);
+    }
+}
+
+watch(() => settingsStore.settings.ui_scale, applyUiScale);
+onMounted(() => {
+    applyUiScale();
+    document.addEventListener('fullscreenchange', applyUiScale);
+});
+onUnmounted(() => {
+    document.removeEventListener('fullscreenchange', applyUiScale);
+});
 
