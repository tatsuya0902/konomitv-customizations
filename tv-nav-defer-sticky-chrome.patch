+// sticky / fixed な要素の中にあるかどうか
+// (タブバーのように画面上部へ張り付くバーは、常に現在位置の近くに
+//  見えるため、縦移動の候補として本来の項目より優先されてしまう)
+function isInStickyChrome(el: HTMLElement): boolean {
+    let node: HTMLElement | null = el;
+    while (node !== null && node !== document.body) {
+        const pos = window.getComputedStyle(node).position;
+        if (pos === 'sticky' || pos === 'fixed') {
+            return true;
+        }
+        node = node.parentElement;
+    }
+    return false;
+}
