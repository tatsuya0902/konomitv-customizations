+<script lang="ts">
+
+import { defineComponent } from 'vue';
+
+import Message from '@/message';
+import Channels, { IChannel } from '@/services/Channels';
+import ReservationConditions, { IReservationCondition } from '@/services/ReservationConditions';
+
+// ローカル改造: キーワード自動予約条件 (シリーズ予約) の一覧表示と削除を行うダイアログ
+// 条件の作成は視聴画面パネルと予約詳細ドロワーの「シリーズ予約」から行う
+export default defineComponent({
+    name: 'ReservationConditionsDialog',
+    props: {
+        show: {
+            type: Boolean,
+            default: false,
+        },
+    },
+    emits: ['update:show'],
+    data() {
+        return {
+            // 自動予約条件の一覧
+            conditions: [] as IReservationCondition[],
+            // チャンネル名の解決用 (全チャンネルをフラットに保持)
+            channels: [] as IChannel[],
+            is_loading: false,
+            // 削除確認中の条件
+            deleting: null as IReservationCondition | null,
+            show_delete_confirm: false,
+            is_deleting: false,
+        };
+    },
+    watch: {
+        // ダイアログが開かれたら最新の条件を取得する
+        async show(is_shown: boolean): Promise<void> {
+            if (is_shown) {
+                await this.load();
+            }
+        },
+    },
+    methods: {
+        async load(): Promise<void> {
+            this.is_loading = true;
+            try {
+                const [conditions_result, channels_result] = await Promise.all([
+                    ReservationConditions.fetchReservationConditions(),
+                    Channels.fetchAllChannels(),
+                ]);
+                this.conditions = conditions_result?.reservation_conditions ?? [];
+                if (channels_result) {
+                    this.channels = [
+                        ...channels_result.GR, ...channels_result.BS, ...channels_result.CS,
+                        ...channels_result.CATV, ...channels_result.SKY,
+                    ];
+                }
+            } finally {
+                this.is_loading = false;
+            }
+        },
+        // 条件の見出し (キーワード)
+        keywordLabel(condition: IReservationCondition): string {
+            const keyword = condition.program_search_condition.keyword;
+            return keyword !== '' ? keyword : '（キーワード指定なし）';
+        },
+        // チャンネル名と予約追加件数の行
+        metaLine(condition: IReservationCondition): string {
+            const ranges = condition.program_search_condition.service_ranges;
+            let channel_label = '全チャンネル';
+            if (ranges !== null && ranges.length > 0) {
+                channel_label = ranges.map((range) => {
+                    const channel = this.channels.find((ch) =>
+                        ch.network_id === range.network_id &&
+                        ch.transport_stream_id === range.transport_stream_id &&
+                        ch.service_id === range.service_id);
+                    return channel?.name ?? `SID ${range.service_id}`;
+                }).join('、');
+            }
+            return `${channel_label} ・ これまでの予約追加 ${condition.reservation_count} 件`;
+        },
+        // 削除の確認を出す
+        askDelete(condition: IReservationCondition): void {
+            this.deleting = condition;
+            this.show_delete_confirm = true;
+        },
+        // 条件を削除する
+        async confirmDelete(): Promise<void> {
+            if (this.deleting === null || this.is_deleting) {
+                return;
+            }
+            this.is_deleting = true;
+            try {
+                const success = await ReservationConditions.deleteReservationCondition(this.deleting.id);
+                if (success) {
+                    Message.show('自動予約の条件を削除しました。');
+                    this.show_delete_confirm = false;
+                    this.deleting = null;
+                    await this.load();
+                }
+            } finally {
+                this.is_deleting = false;
+            }
+        },
+    },
+});
