+
+import DPlayer from 'dplayer';
+
+import PlayerManager from '@/services/player/PlayerManager';
+import usePlayerStore from '@/stores/PlayerStore';
+import useSettingsStore from '@/stores/SettingsStore';
+
+
+/**
+ * CM 区間へ入ったら自動で CM の終わりまでスキップする PlayerManager (ローカル改造)
+ * 設定 (video_cm_auto_skip) が有効な場合のみ動作する。手動のチャプター移動は常時可能
+ */
+class CmAutoSkipManager implements PlayerManager {
+
+    // ユーザー操作により DPlayer 側で画質が切り替わった際、この PlayerManager の再起動が必要かどうかを PlayerController に示す値
+    public readonly restart_required_when_quality_switched = false;
+
+    // DPlayer のインスタンス
+    private readonly player: DPlayer;
+
+    // 再生モード (Live: ライブ視聴, Video: ビデオ視聴)
+    private readonly playback_mode: 'Live' | 'Video';
+
+    // 破棄済みかどうか
+    private destroyed = false;
+
+    // timeupdate イベントのハンドラ
+    private timeupdate_handler: (() => void) | null = null;
+
+    // 前回の timeupdate 時点の再生位置 (CM 区間の開始を跨いだかを判定するために使う)
+    private last_position = -1;
+
+    /**
+     * コンストラクタ
+     * @param player DPlayer のインスタンス
+     * @param playback_mode 再生モード (Live: ライブ視聴, Video: ビデオ視聴)
+     */
+    constructor(player: DPlayer, playback_mode: 'Live' | 'Video') {
+        this.player = player;
+        this.playback_mode = playback_mode;
+    }
+
+
+    /**
+     * CM 自動スキップの監視を開始する
+     */
+    public async init(): Promise<void> {
+        this.destroyed = false;
+        this.last_position = -1;
+
+        // 録画再生時のみ動作する
+        if (this.playback_mode !== 'Video') {
+            return;
+        }
+
+        this.timeupdate_handler = () => this.onTimeUpdate();
+        this.player.video.addEventListener('timeupdate', this.timeupdate_handler);
+    }
+
+
+    /**
+     * CM 自動スキップの監視を終了する
+     */
+    public async destroy(): Promise<void> {
+        if (this.timeupdate_handler !== null) {
+            this.player.video.removeEventListener('timeupdate', this.timeupdate_handler);
+            this.timeupdate_handler = null;
+        }
+        this.destroyed = true;
+    }
+
+
+    // 再生位置の更新ごとに、CM 区間の開始を跨いだら区間の終わりへスキップする
+    private onTimeUpdate(): void {
+        if (this.destroyed === true) {
+            return;
+        }
+        const video = this.player.video;
+        const now = video.currentTime;
+
+        // 一時停止中は判定しない (再開位置の記録だけ更新する)
+        if (video.paused === true) {
+            this.last_position = now;
+            return;
+        }
+
+        // 設定が無効な場合は何もしない
+        const settings_store = useSettingsStore();
+        if (settings_store.settings.video_cm_auto_skip !== true) {
+            this.last_position = now;
+            return;
+        }
+
+        // CM 区間がない録画では何もしない
+        const player_store = usePlayerStore();
+        const cm_sections = player_store.recorded_program?.recorded_video?.cm_sections;
+        if (!cm_sections || cm_sections.length === 0) {
+            this.last_position = now;
+            return;
+        }
+
+        const prev = this.last_position;
+        this.last_position = now;
+        if (prev < 0) {
+            return;
+        }
+
+        for (const section of cm_sections) {
+            // 再生が CM 区間の開始を跨いだら、CM の終わりまでスキップする
+            // (シークで CM 区間の途中へ入った場合は、開始を跨いでいないためスキップしない)
+            if (prev < section.start_time && now >= section.start_time && now < section.end_time) {
+                this.player.seek(section.end_time);
+                this.player.notice('CM をスキップしました');
+                this.last_position = section.end_time;
+                return;
+            }
+        }
+    }
+}
+
+export default CmAutoSkipManager;
