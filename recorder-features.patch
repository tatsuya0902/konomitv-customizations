+import Videos, { IJikkyoComment } from '@/services/Videos';
+
+/**
+ * 実況コメントの密度 (盛り上がり) を計算する共通ユーティリティ (ローカル改造)
+ *
+ * ExcitementManager (プレイヤー内のグラフ表示・ダイジェスト再生) と同じ計算方法で、
+ * 番組情報パネルの「見どころ」表示やハイライト横断再生から利用する。
+ * 計算方法: 5秒ビンに集計 → 3ビンの移動平均で平滑化 → 最大値で正規化し、
+ * 最大値の40%以上の連続区間 (隙間2ビンまで連結、3ビン未満は除外) を盛り上がり区間とする。
+ * ただし区間の合計が全体の70%を超える場合は、盛り上がり区間としては扱わない。
+ */
+
+// 1 ビンの秒数
+export const COMMENT_BIN_SECONDS = 5;
+
+// 盛り上がりとして扱うために必要なコメント総数の下限
+export const MIN_COMMENTS_FOR_HIGHLIGHTS = 50;
+
+// 盛り上がり区間とみなす密度の閾値 (最大値に対する比率)
+const SEGMENT_THRESHOLD_RATIO = 0.4;
+// 連結を許す隙間の最大ビン数
+const MAX_GAP_BINS = 2;
+// 区間として扱う最小ビン数
+const MIN_SEGMENT_BINS = 3;
+// 区間の合計がこの比率を超えたら盛り上がり区間として扱わない
+const MAX_COVERAGE_RATIO = 0.7;
+
+/** 盛り上がり区間 */
+export interface IHighlightSegment {
+    start: number;  // 開始位置 (秒)
+    end: number;  // 終了位置 (秒)
+    peak_density: number;  // 区間内の最大密度 (0.0〜1.0)
+    comment_count: number;  // 区間内のコメント数
+}
+
+/** コメント密度の計算結果 */
+export interface ICommentDensity {
+    densities: number[];  // 正規化済み密度 (ビンごと)
+    counts: number[];  // 生のコメント数 (ビンごと)
+    total: number;  // コメント総数
+    duration: number;  // 計算に使った尺 (秒)
+}
+
+
+/**
+ * 指定された録画の過去ログコメントを取得し、密度を計算する
+ * コメントが取得できない場合は null、コメントが少ない場合は total が下限未満の結果を返す
+ * @param video_id 録画の ID
+ * @param duration 録画の尺 (秒)
+ */
+export async function fetchCommentDensity(video_id: number, duration: number): Promise<ICommentDensity | null> {
+    const result = await Videos.fetchVideoJikkyoComments(video_id);
+    if (result.is_success !== true) {
+        return null;
+    }
+    return computeCommentDensity(result.comments, duration);
+}
+
+
+/**
+ * コメントのリストから密度を計算する
+ * @param comments 過去ログコメント (time が再生位置 (秒) のもの)
+ * @param duration 録画の尺 (秒)。0 の場合はコメントの最大位置から推定する
+ */
+export function computeCommentDensity(comments: IJikkyoComment[], duration: number): ICommentDensity {
+    const positions = comments.map((comment) => comment.time);
+    const max_position = positions.reduce((max, pos) => Math.max(max, pos), 0);
+    const effective_duration = duration > 0 ? duration : max_position + COMMENT_BIN_SECONDS;
+
+    const bin_count = Math.max(1, Math.ceil(effective_duration / COMMENT_BIN_SECONDS));
+    const counts = new Array<number>(bin_count).fill(0);
+    for (const position of positions) {
+        const index = Math.min(bin_count - 1, Math.max(0, Math.floor(position / COMMENT_BIN_SECONDS)));
+        counts[index] += 1;
+    }
+    // 3 ビンの移動平均で平滑化し、最大値で正規化する (ExcitementManager と同じ)
+    const smoothed = counts.map((_, i) => {
+        const prev = counts[Math.max(0, i - 1)];
+        const curr = counts[i];
+        const next = counts[Math.min(bin_count - 1, i + 1)];
+        return (prev + curr * 2 + next) / 4;
+    });
+    const max_density = Math.max(...smoothed, 0.0001);
+    const densities = smoothed.map((value) => value / max_density);
+    return { densities, counts, total: comments.length, duration: effective_duration };
+}
+
+
+/**
+ * 密度から盛り上がり区間を抽出する (ExcitementManager と同じルール)
+ * @param density コメント密度の計算結果
+ */
+export function extractHighlightSegments(density: ICommentDensity): IHighlightSegment[] {
+    const hot = density.densities.map((value) => value >= SEGMENT_THRESHOLD_RATIO);
+    // 隙間埋め
+    for (let i = 0; i < hot.length; i++) {
+        if (hot[i] === true) {
+            continue;
+        }
+        let gap = 0;
+        while (i + gap < hot.length && hot[i + gap] === false) {
+            gap++;
+        }
+        const before = i > 0 && hot[i - 1] === true;
+        const after = i + gap < hot.length && hot[i + gap] === true;
+        if (before && after && gap <= MAX_GAP_BINS) {
+            for (let j = 0; j < gap; j++) {
+                hot[i + j] = true;
+            }
+        }
+        i += gap;
+    }
+    // 連続区間の抽出と短い区間の除外
+    const segments: IHighlightSegment[] = [];
+    let start_bin: number | null = null;
+    for (let i = 0; i <= hot.length; i++) {
+        if (i < hot.length && hot[i] === true) {
+            if (start_bin === null) {
+                start_bin = i;
+            }
+        } else if (start_bin !== null) {
+            if (i - start_bin >= MIN_SEGMENT_BINS) {
+                let peak = 0;
+                let comment_count = 0;
+                for (let bin = start_bin; bin < i; bin++) {
+                    peak = Math.max(peak, density.densities[bin]);
+                    comment_count += density.counts[bin];
+                }
+                segments.push({
+                    start: start_bin * COMMENT_BIN_SECONDS,
+                    end: i * COMMENT_BIN_SECONDS,
+                    peak_density: peak,
+                    comment_count,
+                });
+            }
+            start_bin = null;
+        }
+    }
+    // カバー率が高すぎる場合は盛り上がり区間として扱わない
+    const covered = segments.reduce((sum, segment) => sum + (segment.end - segment.start), 0);
+    if (density.duration > 0 && covered / density.duration > MAX_COVERAGE_RATIO) {
+        return [];
+    }
+    return segments;
+}
+
+
+/**
+ * 秒数を m:ss / h:mm:ss 形式の文字列にする
+ * @param seconds 秒数
+ */
+export function formatPlaybackTime(seconds: number): string {
+    const total = Math.max(0, Math.floor(seconds));
+    const hours = Math.floor(total / 3600);
+    const minutes = Math.floor((total % 3600) / 60);
+    const secs = total % 60;
+    if (hours > 0) {
+        return `${hours}:${minutes.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
+    }
+    return `${minutes}:${secs.toString().padStart(2, '0')}`;
+}
