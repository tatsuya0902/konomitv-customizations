+"""録画結果 (成功 / 一部のみ / 失敗) の記録。
+
+ローカル改造 (2026-11-15): EPGStation は終了した予約や失敗した録画を DB に残さないため、
+「予約したのに録れなかった」ことが後から分からない。そこで KonomiTV 側で
+EPGStation の DB (SQLite、読み取り専用) を定期的に照合し、放送前の予約の控えを取り、
+終了後に録画の有無・尺・ドロップ数から結果を判定して DATA_DIR/recording-results.json に
+記録する。市販レコーダーの「録画結果」一覧に相当する機能。
+
+判定ルール:
+- 録画ファイルがあり、尺が予定の 95% 以上: success
+- 録画ファイルはあるが尺が予定の 95% 未満: partial
+- 終了から猶予 (10 分) を過ぎても録画ファイルがない: failed
+過去の録画 (recorded テーブルに残っているもの) は初回照合時に成功 / 一部として取り込む。
+失敗は EPGStation 側に記録が残らないため、この照合が動いている期間分しか記録できない。
+"""
+
+import json
+import logging
+import os
+import re
+import sqlite3
+import threading
+import time
+from pathlib import Path
+
+from app.constants import DATA_DIR
+
+
+STATE_PATH = DATA_DIR / 'recording-results.json'
+
+# 終了からこの時間 (秒) は録画ファイルの確定待ちとする
+GRACE_SECONDS = 10 * 60
+# 保持する結果の最大件数
+MAX_RESULTS = 100
+
+_lock = threading.Lock()
+
+
+def _epgstationDBPath() -> Path | None:
+    """EPGStation の SQLite DB のパスを返す。見つからなければ None。"""
+    env_path = os.environ.get('KONOMITV_EPGSTATION_DB_PATH')
+    if env_path:
+        path = Path(env_path)
+        return path if path.exists() else None
+    path = Path.home() / 'EPGStation' / 'data' / 'database.db'
+    return path if path.exists() else None
+
+
+def _loadState() -> dict:
+    """記録済みの状態を読み込む。ファイルがない・壊れている場合は空として扱う。"""
+    try:
+        raw = json.loads(STATE_PATH.read_text(encoding='utf-8'))
+        return {'pending': raw.get('pending', {}), 'results': raw.get('results', [])}
+    except FileNotFoundError:
+        return {'pending': {}, 'results': []}
+    except Exception:
+        logging.exception('[RecordingResults] Failed to load recording results.')
+        return {'pending': {}, 'results': []}
+
+
+def _saveState(state: dict) -> None:
+    """状態を保存する (一時ファイルに書いてから置き換える)。"""
+    tmp_path = STATE_PATH.with_suffix('.json.tmp')
+    tmp_path.write_text(json.dumps(state, ensure_ascii=False, indent=2), encoding='utf-8')
+    tmp_path.replace(STATE_PATH)
+
+
+def _cleanName(name: str | None) -> str:
+    """EPGStation の番組名に含まれる \\uXXXX 形式のリテラルを実文字に戻す。"""
+    if not name:
+        return ''
+    return re.sub(r'\\u([0-9a-fA-F]{4})', lambda match: chr(int(match.group(1), 16)), name)
+
+
+def _dropCounts(connection: sqlite3.Connection, drop_log_file_id) -> dict:
+    """ドロップログの件数を取得する。ログがなければ全て None。"""
+    counts = {'error_count': None, 'drop_count': None, 'scrambling_count': None}
+    if drop_log_file_id is None:
+        return counts
+    row = connection.execute(
+        'SELECT errorCnt, dropCnt, scramblingCnt FROM drop_log_file WHERE id = ?',
+        (drop_log_file_id,),
+    ).fetchone()
+    if row is not None:
+        counts = {'error_count': row[0], 'drop_count': row[1], 'scrambling_count': row[2]}
+    return counts
+
+
+def _classify(scheduled_seconds: float, duration_seconds: float) -> str:
+    """予定尺と実尺から成功 / 一部を判定する。"""
+    if scheduled_seconds > 0 and duration_seconds >= scheduled_seconds * 0.95:
+        return 'success'
+    return 'partial'
+
+
+def reconcile() -> None:
+    """EPGStation の DB と照合し、予約の控え取りと結果の判定を行う。"""
+    db_path = _epgstationDBPath()
+    if db_path is None:
+        return
+    try:
+        connection = sqlite3.connect(f'file:{db_path}?mode=ro', uri=True, timeout=5)
+        try:
+            channels = {row[0]: _cleanName(row[1]) for row in connection.execute('SELECT id, name FROM channel')}
+            reserves = connection.execute('SELECT id, name, channelId, startAt, endAt, isSkip FROM reserve').fetchall()
+            now_seconds = time.time()
+
+            with _lock:
+                state = _loadState()
+                pending: dict = state['pending']
+                results: list = state['results']
+                known_result_ids = {entry['reserve_id'] for entry in results}
+                current_reserve_ids = set()
+
+                # 放送前の予約の控えを取る (スキップ指定の予約は対象外)
+                for reserve_id, name, channel_id, start_at, end_at, is_skip in reserves:
+                    current_reserve_ids.add(reserve_id)
+                    if is_skip:
+                        pending.pop(str(reserve_id), None)
+                        continue
+                    pending[str(reserve_id)] = {
+                        'reserve_id': reserve_id,
+                        'name': _cleanName(name),
+                        'channel_name': channels.get(channel_id, ''),
+                        'start_at': start_at / 1000,
+                        'end_at': end_at / 1000,
+                    }
+
+                # 開始前に予約が消えたものはキャンセルされたとみなして控えから外す
+                for key in list(pending.keys()):
+                    entry = pending[key]
+                    if entry['reserve_id'] not in current_reserve_ids and now_seconds < entry['start_at']:
+                        del pending[key]
+
+                # 終了 + 猶予を過ぎた控えを結果として確定する
+                for key in list(pending.keys()):
+                    entry = pending[key]
+                    if now_seconds < entry['end_at'] + GRACE_SECONDS:
+                        continue
+                    recorded = connection.execute(
+                        'SELECT id, duration, dropLogFileId FROM recorded WHERE reserveId = ? AND isRecording = 0',
+                        (entry['reserve_id'],),
+                    ).fetchone()
+                    result = {**entry, 'resolved_at': now_seconds}
+                    if recorded is None:
+                        result.update({
+                            'status': 'failed',
+                            'recorded_id': None,
+                            'duration': None,
+                            'error_count': None,
+                            'drop_count': None,
+                            'scrambling_count': None,
+                        })
+                    else:
+                        duration_seconds = (recorded[1] or 0) / 1000
+                        result.update({
+                            'status': _classify(entry['end_at'] - entry['start_at'], duration_seconds),
+                            'recorded_id': recorded[0],
+                            'duration': duration_seconds,
+                            **_dropCounts(connection, recorded[2]),
+                        })
+                    if entry['reserve_id'] not in known_result_ids:
+                        results.append(result)
+                        known_result_ids.add(entry['reserve_id'])
+                    del pending[key]
+
+                # 過去の録画を結果として取り込む (控え取り開始前に終わった予約分)
+                for recorded in connection.execute(
+                    'SELECT id, reserveId, name, channelId, startAt, endAt, duration, dropLogFileId'
+                    ' FROM recorded WHERE isRecording = 0 AND reserveId IS NOT NULL'
+                ):
+                    recorded_id, reserve_id, name, channel_id, start_at, end_at, duration, drop_log_file_id = recorded
+                    if reserve_id in known_result_ids or str(reserve_id) in pending:
+                        continue
+                    duration_seconds = (duration or 0) / 1000
+                    results.append({
+                        'reserve_id': reserve_id,
+                        'name': _cleanName(name),
+                        'channel_name': channels.get(channel_id, ''),
+                        'start_at': start_at / 1000,
+                        'end_at': end_at / 1000,
+                        'resolved_at': now_seconds,
+                        'status': _classify((end_at - start_at) / 1000, duration_seconds),
+                        'recorded_id': recorded_id,
+                        'duration': duration_seconds,
+                        **_dropCounts(connection, drop_log_file_id),
+                    })
+                    known_result_ids.add(reserve_id)
+
+                # 新しい順に並べ替えて上限まで保持する
+                results.sort(key=lambda entry: entry['start_at'], reverse=True)
+                state['results'] = results[:MAX_RESULTS]
+                _saveState(state)
+        finally:
+            connection.close()
+    except Exception:
+        logging.exception('[RecordingResults] Failed to reconcile recording results.')
+
+
+def listResults() -> list[dict]:
+    """記録済みの録画結果を新しい順で返す。"""
+    return _loadState()['results']
