@@ -0,0 +1,135 @@
+"""録画のゴミ箱 (削除の猶予期間) の状態管理と、期限切れ録画の自動削除。
+
+ローカル改造 (2026-11-13): 市販レコーダーのゴミ箱相当の安全策として新設。
+削除操作ではファイルや DB は一切変更せず、ここに登録して一覧・検索から隠すだけにとどめる。
+復元は登録を取り消すだけ、完全削除は保持期間 (既定 30 日) 経過後に既存の削除経路
+(EPGStation 委譲) で実行する。状態は DATA_DIR/recording-trash.json に保存する。
+"""
+
+import json
+import logging
+import os
+from datetime import datetime, timedelta, timezone
+from pathlib import Path
+
+from app.constants import DATA_DIR
+
+
+# ゴミ箱の保持期間 (日): 環境変数 KONOMITV_TRASH_RETENTION_DAYS で変更可能 (既定: 30 日)
+def _retentionDays() -> int:
+    try:
+        days = int(os.environ.get('KONOMITV_TRASH_RETENTION_DAYS', '30'))
+        return days if days > 0 else 30
+    except ValueError:
+        return 30
+
+
+RETENTION_DAYS = _retentionDays()
+
+STATE_PATH = DATA_DIR / 'recording-trash.json'
+
+
+def _loadState() -> dict[int, dict[str, str]]:
+    """ゴミ箱の状態を読み込む。ファイルがない・壊れている場合は空として扱う。"""
+    try:
+        raw = json.loads(STATE_PATH.read_text(encoding='utf-8'))
+        return {int(video_id): entry for video_id, entry in raw.items()}
+    except FileNotFoundError:
+        return {}
+    except Exception:
+        logging.exception('[RecordingTrash] Failed to load trash state.')
+        return {}
+
+
+def _saveState(state: dict[int, dict[str, str]]) -> None:
+    """ゴミ箱の状態を保存する (一時ファイルに書いてから置き換える)。"""
+    tmp_path = STATE_PATH.with_suffix('.json.tmp')
+    tmp_path.write_text(
+        json.dumps({str(video_id): entry for video_id, entry in state.items()}, ensure_ascii=False, indent=2),
+        encoding='utf-8',
+    )
+    tmp_path.replace(STATE_PATH)
+
+
+def entries() -> dict[int, dict[str, str]]:
+    """ゴミ箱の全エントリ {video_id: {trashed_at, purge_at}} を返す。"""
+    return _loadState()
+
+
+def trashedIds() -> set[int]:
+    """ゴミ箱に入っている録画番組 ID の集合を返す (一覧・検索の除外用)。"""
+    return set(_loadState().keys())
+
+
+def isTrashed(video_id: int) -> bool:
+    return video_id in _loadState()
+
+
+def add(video_id: int) -> None:
+    """録画をゴミ箱へ登録する。"""
+    state = _loadState()
+    now = datetime.now(timezone.utc)
+    state[video_id] = {
+        'trashed_at': now.isoformat(),
+        'purge_at': (now + timedelta(days=RETENTION_DAYS)).isoformat(),
+    }
+    _saveState(state)
+
+
+def remove(video_id: int) -> None:
+    """録画のゴミ箱登録を取り消す (復元・完全削除後の後片付け)。"""
+    state = _loadState()
+    if video_id in state:
+        del state[video_id]
+        _saveState(state)
+
+
+def _postpone(video_id: int, days: int) -> None:
+    """自動削除に失敗したエントリの削除予定を先送りする (リトライ間隔の確保)。"""
+    state = _loadState()
+    if video_id in state:
+        state[video_id]['purge_at'] = (datetime.now(timezone.utc) + timedelta(days=days)).isoformat()
+        _saveState(state)
+
+
+async def purgeExpired() -> None:
+    """保持期間を過ぎたゴミ箱の録画を、既存の削除経路で完全に削除する。
+
+    app.py から 1 時間ごとに呼ばれる。削除に失敗したエントリは予定を 1 日先送りして再試行する。
+    """
+    # 循環 import を避けるため、重い依存は関数内で読み込む
+    from app.models.RecordedProgram import RecordedProgram
+    from app.utils.RecorderDeleteSync import GetRecorderDeleteSync
+
+    now = datetime.now(timezone.utc)
+    for video_id, entry in list(_loadState().items()):
+        try:
+            purge_at = datetime.fromisoformat(entry['purge_at'])
+        except Exception:
+            remove(video_id)
+            continue
+        if purge_at > now:
+            continue
+
+        program = await RecordedProgram.filter(id=video_id).select_related('recorded_video').first()
+        if program is None:
+            # 既に DB から消えている (EPGStation 側で削除された等) 場合はエントリだけ片付ける
+            remove(video_id)
+            continue
+
+        try:
+            service = GetRecorderDeleteSync()
+            if service is not None:
+                plan = await service.plan(video_id, program.recorded_video.file_path)
+                token = service.sign(plan)
+                await service.delete(video_id, program.recorded_video.file_path, token)
+            else:
+                # EPGStation 委譲がない構成向けの簡易削除 (DB レコードとファイル本体)
