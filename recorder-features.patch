+import DPlayer from 'dplayer';
+
+import PlayerManager from '@/services/player/PlayerManager';
+import Videos from '@/services/Videos';
+import usePlayerStore from '@/stores/PlayerStore';
+
+/**
+ * 視聴進捗をサーバーへ報告する PlayerManager (ローカル改造)
+ *
+ * 再生位置の変化 (PlaybackPositionChanged) を受け取り、進み具合に応じて
+ * サーバーの視聴状態 (POST /api/videos/{id}/watched) へ到達位置を報告する。
+ * 視聴状態はサーバー側で一元管理され、一覧の未視聴バッジや未視聴フィルタの
+ * 判定に全端末 (ログアウト中を含む) で使われる。端末ローカルの視聴履歴
+ * (続きから再生用) は従来通り PlayerController 側で記録される。
+ */
+class WatchedReportManager implements PlayerManager {
+
+    // ユーザー操作により DPlayer 側で画質が切り替わった際、この PlayerManager の再起動が必要かどうかを示す値
+    public readonly restart_required_when_quality_switched = false;
+
+    // DPlayer のインスタンス
+    private readonly player: DPlayer;
+
+    // 再生モード (Live: ライブ視聴, Video: ビデオ視聴)
+    private readonly playback_mode: 'Live' | 'Video';
+
+    // イベントハンドラーと、最後に報告した位置・時刻
+    private position_handler: ((event: { playback_position: number }) => void) | null = null;
+    private last_reported_position = -1;
+    private last_reported_at = 0;
+
+    constructor(player: DPlayer, playback_mode: 'Live' | 'Video') {
+        this.player = player;
+        this.playback_mode = playback_mode;
+    }
+
+
+    /**
+     * WatchedReportManager を初期化する
+     * 再生位置の変化を購読し、サーバーへ進捗を報告する
+     */
+    public async init(): Promise<void> {
+        if (this.playback_mode !== 'Video') {
+            return;
+        }
+        this.position_handler = (event) => this.onPositionChanged(event.playback_position);
+        usePlayerStore().event_emitter.on('PlaybackPositionChanged', this.position_handler);
+    }
+
+
+    /**
+     * WatchedReportManager を破棄する
+     * 最後に現在の再生位置を報告してから離脱する
+     */
+    public async destroy(): Promise<void> {
+        if (this.position_handler !== null) {
+            usePlayerStore().event_emitter.off('PlaybackPositionChanged', this.position_handler);
+            this.position_handler = null;
+        }
+        const current_time = this.player.video.currentTime;
+        if (Number.isFinite(current_time) && current_time > this.last_reported_position) {
+            this.report(current_time);
+        }
+    }
+
+
+    /**
+     * 再生位置の変化を受け取り、報告すべきタイミングでのみサーバーへ送る
+     * (10秒以上進んだ場合は最大5秒に1回、それ以外も20秒に1回は送る)
+     * @param position 現在の再生位置 (秒)
+     */
+    private onPositionChanged(position: number): void {
+        const now = Date.now();
+        const advanced = position - this.last_reported_position;
+        const elapsed = now - this.last_reported_at;
+        if ((advanced >= 10 && elapsed >= 5000) || (advanced > 0 && elapsed >= 20000)) {
+            this.report(position);
+        }
+    }
+
+
+    /**
+     * サーバーへ到達位置を報告する (失敗しても視聴の妨げにしない)
+     * @param position 到達した再生位置 (秒)
+     */
+    private report(position: number): void {
+        const video_id = usePlayerStore().recorded_program?.id;
+        if (video_id === undefined || video_id === null) {
+            return;
+        }
+        this.last_reported_position = position;
+        this.last_reported_at = Date.now();
+        Videos.reportWatched(video_id, position).catch(() => {
+            // 報告の失敗は無視する (次回の報告で再送される)
+        });
+    }
+}
+
+export default WatchedReportManager;
