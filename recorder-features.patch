+import DPlayer from 'dplayer';
+
+import router from '@/router';
+import { clearHighlightReel, getHighlightReel, IHighlightReel, saveHighlightReel } from '@/services/HighlightReel';
+import PlayerManager from '@/services/player/PlayerManager';
+import usePlayerStore from '@/stores/PlayerStore';
+
+/**
+ * ハイライト横断再生を制御する PlayerManager (ローカル改造)
+ *
+ * sessionStorage の再生キュー (HighlightReel) があり、開いた録画がキューの現在区間と
+ * 一致する場合に有効になる。区間の開始位置へシークし、終了位置に達したら次の区間へ進む
+ * (別の録画の場合はその視聴画面へ移動する)。キューと一致しない録画を開いた場合は、
+ * ユーザーが手動で移動したとみなしてキューを破棄する。
+ */
+class HighlightReelManager implements PlayerManager {
+
+    // ユーザー操作により DPlayer 側で画質が切り替わった際、この PlayerManager の再起動が必要かどうかを示す値
+    public readonly restart_required_when_quality_switched = false;
+
+    // DPlayer のインスタンス
+    private readonly player: DPlayer;
+
+    // 再生モード (Live: ライブ視聴, Video: ビデオ視聴)
+    private readonly playback_mode: 'Live' | 'Video';
+
+    // 再生キューと、開始シーク済みかどうか、監視タイマーとバッジ要素
+    private reel: IHighlightReel | null = null;
+    private has_seeked_to_start = false;
+    private monitor_timer: ReturnType<typeof setInterval> | null = null;
+    private badge_element: HTMLDivElement | null = null;
+
+    constructor(player: DPlayer, playback_mode: 'Live' | 'Video') {
+        this.player = player;
+        this.playback_mode = playback_mode;
+    }
+
+
+    /**
+     * HighlightReelManager を初期化する
+     * 再生キューがあり、開いた録画が現在の区間と一致する場合のみ有効になる
+     */
+    public async init(): Promise<void> {
+        if (this.playback_mode !== 'Video') {
+            return;
+        }
+        const reel = getHighlightReel();
+        if (reel === null) {
+            return;
+        }
+        const current_item = reel.items[reel.index];
+        const current_video_id = usePlayerStore().recorded_program?.id;
+        if (current_item === undefined || current_item.video_id !== current_video_id) {
+            // 別の録画を開いた = ハイライト再生を中断したとみなす
+            clearHighlightReel();
+            return;
+        }
+        this.reel = reel;
+        this.showBadge();
+        this.monitor_timer = setInterval(() => this.onTick(), 500);
+    }
+
+
+    /**
+     * HighlightReelManager を破棄する
+     * (キュー自体は次の視聴画面へ引き継ぐため、ここでは破棄しない)
+     */
+    public async destroy(): Promise<void> {
+        if (this.monitor_timer !== null) {
+            clearInterval(this.monitor_timer);
+            this.monitor_timer = null;
+        }
+        if (this.badge_element !== null) {
+            this.badge_element.remove();
+            this.badge_element = null;
+        }
+        this.reel = null;
+    }
+
+
+    /**
+     * 「ハイライト再生中 n/m」バッジをプレイヤー左上に表示する (× で中断)
+     */
+    private showBadge(): void {
+        if (this.reel === null) {
+            return;
+        }
+        const badge = document.createElement('div');
+        badge.style.cssText = 'position: absolute; left: 12px; top: 12px; z-index: 60; display: flex; align-items: center; gap: 8px;' +
+            'background: rgba(0,0,0,0.7); color: #fff; border-radius: 999px; padding: 5px 8px 5px 12px; font-size: 12px;';
+        const label = document.createElement('span');
+        label.textContent = `ハイライト再生中 ${this.reel.index + 1}/${this.reel.items.length}`;
+        badge.appendChild(label);
+        const close = document.createElement('button');
+        close.type = 'button';
+        close.textContent = '✕';
+        close.style.cssText = 'border: none; background: rgba(255,255,255,0.2); color: #fff; border-radius: 999px;' +
+            'width: 20px; height: 20px; line-height: 1; cursor: pointer; font-size: 11px;';
+        close.addEventListener('click', (event) => {
+            event.stopPropagation();
+            this.abort();
+        });
+        badge.appendChild(close);
+        this.player.container.appendChild(badge);
+        this.badge_element = badge;
+    }
+
+
+    /**
+     * 500ms ごとの監視。開始シークと、区間終了時の次の区間への進行を行う
+     */
+    private onTick(): void {
+        if (this.reel === null) {
+            return;
+        }
+        const item = this.reel.items[this.reel.index];
+        if (item === undefined) {
+            this.finish();
+            return;
+        }
