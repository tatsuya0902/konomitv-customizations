+"""録画のしおり (ブックマーク) のサーバー側管理。
+
+ローカル改造 (2026-11-15): 見返したい場面の再生位置を端末ごとのローカル保存ではなく
+サーバーで一元管理し、どの端末からでも同じしおりを使えるようにするために新設した。
+視聴状態 (WatchedState) と同様、市販レコーダーと同じく世帯で 1 つの状態として扱う。
+状態は DATA_DIR/bookmarks.json に保存する。
+"""
+
+import json
+import logging
+import threading
+import time
+import uuid
+
+from app.constants import DATA_DIR
+
+
+STATE_PATH = DATA_DIR / 'bookmarks.json'
+
+_lock = threading.Lock()
+
+
+def _loadState() -> dict[int, list[dict]]:
+    """しおりを読み込む。ファイルがない・壊れている場合は空として扱う。"""
+    try:
+        raw = json.loads(STATE_PATH.read_text(encoding='utf-8'))
+        return {int(video_id): entries for video_id, entries in raw.items()}
+    except FileNotFoundError:
+        return {}
+    except Exception:
+        logging.exception('[Bookmarks] Failed to load bookmarks.')
+        return {}
+
+
+def _saveState(state: dict[int, list[dict]]) -> None:
+    """しおりを保存する (一時ファイルに書いてから置き換える)。"""
+    tmp_path = STATE_PATH.with_suffix('.json.tmp')
+    tmp_path.write_text(
+        json.dumps({str(video_id): entries for video_id, entries in state.items()}, ensure_ascii=False, indent=2),
+        encoding='utf-8',
+    )
+    tmp_path.replace(STATE_PATH)
+
+
+def listFor(video_id: int) -> list[dict]:
+    """指定された録画のしおり一覧を、再生位置の昇順で返す。"""
+    entries = _loadState().get(video_id, [])
+    return sorted(entries, key=lambda entry: entry['position'])
+
+
+def add(video_id: int, position: float, label: str) -> dict:
+    """しおりを追加し、追加したしおりを返す。"""
+    bookmark = {
+        'id': uuid.uuid4().hex,
+        'position': float(position),
+        'label': label or '',
+        'created_at': time.time(),
+    }
+    with _lock:
+        state = _loadState()
+        state.setdefault(video_id, []).append(bookmark)
+        _saveState(state)
+    return bookmark
+
+
+def remove(video_id: int, bookmark_id: str) -> bool:
+    """しおりを 1 件削除する。削除できたら True を返す。"""
+    with _lock:
+        state = _loadState()
+        entries = state.get(video_id)
+        if not entries:
+            return False
+        new_entries = [entry for entry in entries if entry['id'] != bookmark_id]
+        if len(new_entries) == len(entries):
+            return False
+        if new_entries:
+            state[video_id] = new_entries
+        else:
+            del state[video_id]
+        _saveState(state)
+    return True
+
+
+def forget(video_id: int) -> None:
+    """録画のしおりをすべて削除する (録画自体の削除に合わせて呼ぶ想定)。"""
+    with _lock:
+        state = _loadState()
+        if video_id in state:
+            del state[video_id]
+            _saveState(state)
