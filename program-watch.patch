diff --git a/client/src/utils/ProgramWatch.ts b/client/src/utils/ProgramWatch.ts
new file mode 100644
index 0000000..db98040
--- /dev/null
+++ b/client/src/utils/ProgramWatch.ts
@@ -0,0 +1,38 @@
+import { computed, onScopeDispose, ref, watch } from 'vue';
+
+import type { IChannel } from '@/services/Channels';
+import type { IProgram } from '@/services/Programs';
+
+import { dayjs } from '@/utils';
+
+/** 開始時刻は含み、終了時刻は含まない。番組 ID を視聴ルートへ流用しない。 */
+export function GetProgramWatchPath(program: Pick<IProgram, 'channel_id' | 'start_time' | 'end_time'> | null,
+    channel: Pick<IChannel, 'id' | 'display_channel_id' | 'is_watchable'> | null, now: number): string | null {
+    if (!program || !channel || !channel.is_watchable || program.channel_id !== channel.id) return null;
+    const start = dayjs(program.start_time).valueOf();
+    const end = dayjs(program.end_time).valueOf();
+    if (!Number.isFinite(start) || !Number.isFinite(end) || end <= start || now < start || now >= end) return null;
+    return `/tv/watch/${encodeURIComponent(channel.display_channel_id)}`;
+}
+
+/** 開いている詳細・選択セルの境界だけを監視する。全番組への定期ポーリングは行わない。 */
+export function useProgramWatch(program: () => IProgram | null, channel: () => IChannel | null, active: () => boolean) {
+    const now = ref(dayjs().valueOf());
+    let timer: ReturnType<typeof setTimeout> | undefined;
+    const refresh = () => {
+        clearTimeout(timer);
+        now.value = dayjs().valueOf();
+        const item = program();
+        if (!active() || !item) return;
+        const nextBoundary = [dayjs(item.start_time).valueOf(), dayjs(item.end_time).valueOf()]
+            .filter(time => time > now.value).sort((a, b) => a - b)[0];
+        if (nextBoundary !== undefined) timer = setTimeout(refresh, Math.min(2147483647, nextBoundary - now.value + 10));
+    };
+    watch([program, channel, active], refresh, {immediate: true});
+    document.addEventListener('visibilitychange', refresh);
+    onScopeDispose(() => {
+        clearTimeout(timer);
+        document.removeEventListener('visibilitychange', refresh);
+    });
+    return computed(() => active() ? GetProgramWatchPath(program(), channel(), now.value) : null);
+}
