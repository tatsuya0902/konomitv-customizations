+/** iOS のデスクトップ表示では iPhone 表記が消えるため、タッチ対応も併せて判定する。 */
+export function IsIOSFullscreenDevice(userAgent: string, platform: string, maxTouchPoints: number, webkitTouchCallout: boolean): boolean {
+    if (/iPhone|iPad|iPod/i.test(userAgent + ' ' + platform)) return true;
+    return maxTouchPoints > 0 && (webkitTouchCallout || /MacIntel|Macintosh/i.test(platform + ' ' + userAgent));
+}
+
+/** ロック状態は推測せず、実際の表示領域が縦長の iPhone だけを回転する。 */
+export function GetPseudoFullscreenGeometry(width: number, height: number, isIPhone: boolean) {
+    const rotated = isIPhone && height > width;
+    return {rotated, width: rotated ? height : width, height: rotated ? width : height};
+}
+
+/** 同じプレイヤー DOM のレイアウトだけを変更する。配信や再生位置には触れない。 */
+export function CreatePseudoFullscreenLayout(container: HTMLElement): () => void {
+    const properties = ['--pseudo-width', '--pseudo-height', '--pseudo-left', '--pseudo-top', '--pseudo-exit-size', 'transform', 'transform-origin'];
+    const previous = properties.map(name => [name, container.style.getPropertyValue(name), container.style.getPropertyPriority(name)]);
+    const previousRotation = container.getAttribute('data-pseudo-rotated');
+    const video = container.querySelector('video');
+    const abort = new AbortController();
+    const ranges: HTMLInputElement[] = [];
+    // DPlayer のドラッグ計算は画面の X 座標を使うため、回転中だけブラウザー標準の range に任せる。
+    // 通常表示・横長表示では元の操作をそのまま使う。
+    const addRange = (selector: string, label: string, kind: 'Seek' | 'Volume') => {
+        const parent = container.querySelector<HTMLElement>(selector);
+        if (!parent || !video) return;
+        const input = document.createElement('input');
+        input.type = 'range';
+        input.className = 'pseudo-rotated-range';
+        input.setAttribute('aria-label', label);
+        input.min = '0';
+        input.step = kind === 'Seek' ? '0.1' : '0.01';
+        const sync = () => {
+            input.max = kind === 'Seek' ? String(Number.isFinite(video.duration) ? video.duration : 0) : '1';
+            input.value = String(kind === 'Seek' ? video.currentTime : video.volume);
+            input.disabled = Number(input.max) === 0;
+        };
+        sync();
+        for (const event of ['timeupdate', 'durationchange', 'volumechange']) {
+            video.addEventListener(event, sync, {signal: abort.signal});
+        }
+        for (const event of ['pointerdown', 'mousedown', 'touchstart', 'click']) {
+            input.addEventListener(event, e => e.stopPropagation(), {signal: abort.signal});
+        }
+        input.addEventListener('keydown', event => {
+            if (event.key !== 'Escape') event.stopPropagation();
+        }, {signal: abort.signal});
+        input.addEventListener('input', () => {
+            container.dispatchEvent(new CustomEvent(`KonomiPseudoFullscreen${kind}`, {bubbles: true, detail: Number(input.value)}));
+        }, {signal: abort.signal});
+        parent.append(input);
+        ranges.push(input);
+    };
+    if (container.classList.contains('watch-container--video')) addRange('.dplayer-bar-wrap', '再生位置', 'Seek');
+    addRange('.dplayer-volume-bar-wrap', '音量', 'Volume');
+    let frame: number | null = null;
+    // iPhone のデスクトップ表示も、iOS のタッチ環境なら回転対象に含める。
+    const isiOSPhone = () => IsIOSFullscreenDevice(navigator.userAgent, navigator.platform,
+        navigator.maxTouchPoints, CSS.supports('-webkit-touch-callout', 'none'));
+    const debug = new URLSearchParams(location.search).get('player_layout_debug') === '1' ? document.createElement('output') : null;
+    if (debug) {
+        debug.style.cssText = 'position:fixed;left:4px;top:4px;z-index:99999;background:#000;color:#fff;font:12px monospace;pointer-events:none;max-width:95vw;white-space:pre-wrap';
+        document.body.append(debug);
+    }
+    const measurements = {shown: '未取得', hidden: '未取得'};
+    const update = () => {
+        frame = null;
+        const viewport = window.visualViewport;
+        const width = viewport?.width ?? window.innerWidth;
+        const height = viewport?.height ?? window.innerHeight;
+        // デスクトップ表示で縮小された場合も、実表示で48px相当のタップ領域を確保する。
+        const scale = Math.max(0.1, viewport?.scale ?? 1);
+        container.style.setProperty('--pseudo-exit-size', `${48 / Math.min(1, scale)}px`);
+        const geometry = GetPseudoFullscreenGeometry(width, height, isiOSPhone());
+        const left = (viewport?.offsetLeft ?? 0) + (geometry.rotated ? width : 0);
+        container.style.setProperty('--pseudo-width', `${geometry.width}px`);
+        container.style.setProperty('--pseudo-height', `${geometry.height}px`);
+        container.style.setProperty('--pseudo-left', `${left}px`);
+        container.style.setProperty('--pseudo-top', `${viewport?.offsetTop ?? 0}px`);
