+</template>
+<script lang="ts" setup>
+
+import { onMounted, ref } from 'vue';
+
+import Breadcrumbs from '@/components/Breadcrumbs.vue';
+import HeaderBar from '@/components/HeaderBar.vue';
+import Navigation from '@/components/Navigation.vue';
+import SPHeaderBar from '@/components/SPHeaderBar.vue';
+import Message from '@/message';
+import Videos, { IRecordingDeletePreview, ITrashItem } from '@/services/Videos';
+import useUserStore from '@/stores/UserStore';
+import Utils, { ProgramUtils } from '@/utils';
+
+// ユーザーストア (管理者判定に使う)
+const userStore = useUserStore();
+
+// ゴミ箱の中身
+const items = ref<ITrashItem[]>([]);
+const retention_days = ref(7);
+const is_loading = ref(true);
+
+// 完全削除の確認ダイアログ
+const show_delete_confirmation = ref(false);
+const delete_target = ref<ITrashItem | null>(null);
+const delete_preview = ref<IRecordingDeletePreview | null>(null);
+
+// ゴミ箱の中身を取得
+const fetchTrash = async () => {
+    const result = await Videos.fetchTrashList();
+    if (result) {
+        items.value = result.items;
+        retention_days.value = result.retention_days;
+    }
+    is_loading.value = false;
+};
+
+// 完全削除までの残り日数
+const remainingDays = (item: ITrashItem): number => {
+    const millis = new Date(item.purge_at).getTime() - Date.now();
+    return Math.max(0, Math.ceil(millis / (24 * 60 * 60 * 1000)));
+};
+
+// 日時表示 (YYYY/MM/DD HH:mm)
+const formatDateTime = (iso: string): string => {
+    const date = new Date(iso);
+    const pad = (value: number) => String(value).padStart(2, '0');
+    return `${date.getFullYear()}/${pad(date.getMonth() + 1)}/${pad(date.getDate())} ${pad(date.getHours())}:${pad(date.getMinutes())}`;
+};
+
+// 復元する
+const restore = async (item: ITrashItem) => {
+    const result = await Videos.restoreFromTrash(item.program.id);
+    if (result) {
+        items.value = items.value.filter((candidate) => candidate.program.id !== item.program.id);
+        Message.success('ゴミ箱から復元しました。');
+    }
+};
+
+// 完全削除の確認ダイアログを開く
+const openDeleteConfirmation = async (item: ITrashItem) => {
+    delete_preview.value = await Videos.fetchDeletePreview(item.program.id);
+    if (delete_preview.value === null) return;
+    delete_target.value = item;
+    show_delete_confirmation.value = true;
+};
+
+// 完全に削除する (既存の削除 API を使う。サーバー側でゴミ箱の登録も取り消される)
+const deletePermanently = async () => {
+    if (delete_target.value === null) return;
+    const target = delete_target.value;
+    show_delete_confirmation.value = false;
+    Message.info('録画ファイルの削除を開始します。完了までしばらくお待ちください。');
+    const result = await Videos.deleteVideo(target.program.id, delete_preview.value?.confirmation_token);
+    if (result === true) {
+        items.value = items.value.filter((candidate) => candidate.program.id !== target.program.id);
+        Message.success('完全に削除しました。');
+    }
+    delete_target.value = null;
+};
+
+// 開始時に実行
+onMounted(async () => {
+    await userStore.fetchUser();
+    await fetchTrash();
+});
+
+</script>
