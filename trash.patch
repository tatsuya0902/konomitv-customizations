+
+
+# ローカル改造 (2026-11-13): 録画のゴミ箱 (削除の猶予期間)
+# 削除操作ではファイルや DB を変更せず、ゴミ箱に登録して一覧・検索から隠すだけにとどめる。
+# 完全削除は保持期間経過後の自動処理、またはゴミ箱画面からの明示的な削除 (既存の削除 API) で行う。
+
+class TrashItem(BaseModel):
+    program: schemas.RecordedProgram
+    trashed_at: str
+    purge_at: str
+
+
+class TrashList(BaseModel):
+    retention_days: int
+    items: list[TrashItem]
+
+
+@router.get('/trash', response_model=TrashList)
+async def TrashListAPI(current_user: Annotated[User, Depends(GetCurrentUser)]):
+    """ゴミ箱内の録画一覧を返す。DB から消えているエントリは掃除する。"""
+    state = RecordingTrash.entries()
+    if not state:
+        return TrashList(retention_days=RecordingTrash.RETENTION_DAYS, items=[])
+    programs = await RecordedProgram.filter(id__in=list(state.keys())).select_related('recorded_video', 'channel')
+    found_ids = {program.id for program in programs}
+    for video_id in list(state.keys()):
+        if video_id not in found_ids:
+            RecordingTrash.remove(video_id)
+            del state[video_id]
+    items = [
+        TrashItem(
+            program = schemas.RecordedProgram.model_validate(program),
+            trashed_at = state[program.id]['trashed_at'],
+            purge_at = state[program.id]['purge_at'],
+        )
+        for program in programs
+    ]
+    items.sort(key=lambda item: item.purge_at)
+    return TrashList(retention_days=RecordingTrash.RETENTION_DAYS, items=items)
+
+
+@router.post('/trash/{video_id}', status_code=status.HTTP_204_NO_CONTENT)
+async def MoveToTrashAPI(video_id: int, current_user: Annotated[User, Depends(GetCurrentAdminUser)]):
+    """録画をゴミ箱へ移動する (ファイルや DB は変更しない)。"""
+    program = await RecordedProgram.filter(id=video_id).select_related('recorded_video').first()
+    if program is None:
+        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail='Video not found')
+    if program.recorded_video.status == 'Recording':
+        raise HTTPException(status_code=status.HTTP_409_CONFLICT, detail='Recording is still in progress')
+    if RecordingTrash.isTrashed(video_id):
+        raise HTTPException(status_code=status.HTTP_409_CONFLICT, detail='Already in trash')
+    RecordingTrash.add(video_id)
+
+
+@router.post('/trash/{video_id}/restore', status_code=status.HTTP_204_NO_CONTENT)
+async def RestoreFromTrashAPI(video_id: int, current_user: Annotated[User, Depends(GetCurrentAdminUser)]):
+    """録画をゴミ箱から復元する。"""
+    if not RecordingTrash.isTrashed(video_id):
+        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail='Not in trash')
+    RecordingTrash.remove(video_id)
