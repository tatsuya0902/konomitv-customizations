+                            <img class="trash-item__thumbnail" loading="lazy" decoding="async"
+                                :src="`${Utils.api_base_url}/videos/${item.program.id}/thumbnail`">
+                            <div class="trash-item__info">
+                                <div class="trash-item__title">{{ item.program.title }}</div>
