+
+    <!-- 完全削除の確認ダイアログ -->
+    <v-dialog max-width="750" v-model="show_delete_confirmation">
+        <v-card v-if="delete_target !== null">
+            <v-card-title class="d-flex justify-center pt-6 font-weight-bold">本当に完全に削除しますか？</v-card-title>
+            <v-card-text class="pt-2 pb-0">
+                <div class="font-weight-bold mb-2">{{ delete_target.program.title }}</div>
+                <template v-if="delete_preview?.enabled && delete_preview.plan">
+                    <div class="mb-2">管理元: EPGStation / 録画ID: {{ delete_preview.plan.epgstation_id }}</div>
+                    <div class="mb-4">録画本体はEPGStationで削除し、KonomiTVとJellyfinの一覧も更新します。</div>
+                </template>
+                <div class="text-error-lighten-1 font-weight-bold">
+                    ゴミ箱からも消え、元に戻すことはできません。本当に完全に削除しますか？
+                </div>
+            </v-card-text>
+            <v-card-actions class="pt-4 px-6 pb-6">
+                <v-spacer></v-spacer>
